---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';

const coupons = await prisma.coupon.findMany({ orderBy: { createdAt: 'desc' } });
const products = await prisma.product.findMany({
  where: { isPublished: true },
  select: { id: true, name: true },
  orderBy: { name: 'asc' }
});
---
<AdminLayout title="Manajemen Kupon" currentPage="coupons">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Kupon & Promo</h2>
      <p class="text-sm text-gray-500">{coupons.length} kupon terdaftar</p>
    </div>
    <button id="add-btn" class="btn-primary text-sm">+ Tambah Kupon</button>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100">
            <th class="p-4 text-xs font-semibold text-gray-500 uppercase">Kode Kupon</th>
            <th class="p-4 text-xs font-semibold text-gray-500 uppercase">Tipe & Nilai</th>
            <th class="p-4 text-xs font-semibold text-gray-500 uppercase">Min. Order</th>
            <th class="p-4 text-xs font-semibold text-gray-500 uppercase">Berlaku Untuk</th>
            <th class="p-4 text-xs font-semibold text-gray-500 uppercase">Masa Berlaku</th>
            <th class="p-4 text-xs font-semibold text-gray-500 uppercase">Pemakaian</th>
            <th class="p-4 text-xs font-semibold text-gray-500 uppercase">Status</th>
            <th class="p-4 text-xs font-semibold text-gray-500 uppercase text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {coupons.map(c => (
            <tr class="hover:bg-blue-50/50 transition-colors">
              <td class="p-4">
                <span class="font-bold text-blue-700 bg-blue-100 px-2 py-1 rounded border border-blue-200 tracking-wider text-sm">{c.code}</span>
              </td>
              <td class="p-4">
                <p class="font-medium text-gray-900 text-sm">
                  {c.discountType === 'percentage' ? `${c.discountValue}%` : `Rp ${Number(c.discountValue).toLocaleString('id')}`}
                </p>
                <p class="text-[10px] text-gray-500 uppercase">{c.discountType}</p>
              </td>
              <td class="p-4 text-sm text-gray-600">
                {Number(c.minOrderValue) > 0 ? `Rp ${Number(c.minOrderValue).toLocaleString('id')}` : '-'}
              </td>
              <td class="p-4 text-sm text-gray-600">
                {Array.isArray(c.applicableProducts) && c.applicableProducts.length > 0 ? `${c.applicableProducts.length} Produk` : 'Semua Produk'}
              </td>
              <td class="p-4 text-sm">
                {c.expiryDate ? (
                  <span class={new Date(c.expiryDate) < new Date() ? 'text-red-500 font-medium' : 'text-gray-600'}>
                    {new Date(c.expiryDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </span>
                ) : <span class="text-gray-400">Selamanya</span>}
              </td>
              <td class="p-4 text-sm text-gray-600">
                {c.usageCount} {c.usageLimit ? `/ ${c.usageLimit}` : ''}
              </td>
              <td class="p-4">
                <span class={`text-xs px-2 py-1 rounded-md font-medium ${c.enabled ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                  {c.enabled ? 'Aktif' : 'Nonaktif'}
                </span>
              </td>
              <td class="p-4 text-right">
                <button 
                  data-id={c.id} 
                  data-code={c.code} 
                  data-type={c.discountType}
                  data-value={c.discountValue}
                  data-min={c.minOrderValue}
                  data-expiry={c.expiryDate ? new Date(c.expiryDate).toISOString().split('T')[0] : ''}
                  data-limit={c.usageLimit || ''}
                  data-enabled={c.enabled.toString()}
                  data-products={JSON.stringify(c.applicableProducts || [])}
                  class="edit-btn text-blue-500 hover:text-blue-700 mr-2 p-1"
                  title="Edit"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                </button>
                <button 
                  data-id={c.id} 
                  class="delete-btn text-red-400 hover:text-red-600 p-1"
                  title="Hapus"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </td>
            </tr>
          ))}
          {coupons.length === 0 && (
            <tr><td colspan="7" class="p-8 text-center text-gray-500">Belum ada kupon yang ditambahkan.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal -->
  <div id="modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-lg shadow-xl">
      <h3 id="modal-title" class="font-bold text-gray-900 text-lg mb-4">Tambah Kupon</h3>
      <form id="form" class="space-y-4">
        <input type="hidden" name="id" id="f-id" />
        
        <div>
          <label class="label">Kode Kupon *</label>
          <input name="code" id="f-code" required class="input-field uppercase tracking-widest" placeholder="PROMO2026" />
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label">Tipe Diskon *</label>
            <select name="discountType" id="f-type" required class="input-field">
              <option value="percentage">Persentase (%)</option>
              <option value="fixed">Nominal (Rp)</option>
            </select>
          </div>
          <div>
            <label class="label">Nilai Diskon *</label>
            <input name="discountValue" id="f-value" type="number" required class="input-field" placeholder="10 / 50000" />
          </div>
        </div>

        <div>
          <label class="label">Minimum Order (Opsional)</label>
          <input name="minOrderValue" id="f-min" type="number" class="input-field" placeholder="100000" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label">Batas Kuota Penggunaan (Opsional)</label>
            <input name="usageLimit" id="f-limit" type="number" class="input-field" placeholder="Contoh: 100" />
          </div>
          <div>
            <label class="label">Berlaku Hingga (Opsional)</label>
            <input name="expiryDate" id="f-expiry" type="date" class="input-field" />
          </div>
        </div>

        <div>
          <label class="label mb-2 block">Berlaku Untuk Produk (Opsional)</label>
          <div class="max-h-40 overflow-y-auto border border-gray-200 rounded-lg p-3 space-y-2">
            {products.map(p => (
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="applicableProducts" value={p.id} class="product-checkbox w-4 h-4 text-blue-600 rounded border-gray-300" />
                <span class="text-sm text-gray-700">{p.name}</span>
              </label>
            ))}
            {products.length === 0 && <p class="text-xs text-gray-500">Tidak ada produk tersedia.</p>}
          </div>
          <p class="text-xs text-gray-500 mt-1">Biarkan kosong agar kupon berlaku untuk semua produk.</p>
        </div>

        <div class="flex items-center gap-2 mt-4">
          <input type="checkbox" name="enabled" id="f-enabled" class="w-4 h-4 text-blue-600 rounded border-gray-300" checked />
          <label for="f-enabled" class="text-sm font-medium text-gray-700">Kupon Aktif</label>
        </div>

        <div class="flex gap-3 pt-4">
          <button type="submit" class="btn-primary flex-1">Simpan Kupon</button>
          <button type="button" id="close-modal" class="btn-ghost flex-1">Batal</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const modal = document.getElementById('modal')!;
  const form = document.getElementById('form') as HTMLFormElement;
  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  document.getElementById('add-btn')?.addEventListener('click', () => {
    form.reset();
    (document.getElementById('f-id') as HTMLInputElement).value = '';
    (document.getElementById('f-enabled') as HTMLInputElement).checked = true;
    document.querySelectorAll('.product-checkbox').forEach(cb => (cb as HTMLInputElement).checked = false);
    document.getElementById('modal-title')!.textContent = 'Tambah Kupon';
    modal.classList.remove('hidden');
  });

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      (document.getElementById('f-id') as HTMLInputElement).value = el.dataset.id!;
      (document.getElementById('f-code') as HTMLInputElement).value = el.dataset.code!;
      (document.getElementById('f-type') as HTMLSelectElement).value = el.dataset.type!;
      (document.getElementById('f-value') as HTMLInputElement).value = el.dataset.value!;
      (document.getElementById('f-min') as HTMLInputElement).value = el.dataset.min || '';
      (document.getElementById('f-limit') as HTMLInputElement).value = el.dataset.limit || '';
      (document.getElementById('f-expiry') as HTMLInputElement).value = el.dataset.expiry || '';
      (document.getElementById('f-enabled') as HTMLInputElement).checked = el.dataset.enabled === 'true';
      
      const products = JSON.parse(el.dataset.products || '[]');
      document.querySelectorAll('.product-checkbox').forEach(cb => {
        (cb as HTMLInputElement).checked = products.includes((cb as HTMLInputElement).value);
      });

      document.getElementById('modal-title')!.textContent = 'Edit Kupon';
      modal.classList.remove('hidden');
    });
  });

  document.getElementById('close-modal')?.addEventListener('click', () => modal.classList.add('hidden'));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyimpan...';

    try {
      const fd = new FormData(form);
      const data: any = Object.fromEntries(fd);
      const id = data.id as string;
      
      // Parse enabled from checkbox
      data.enabled = !!form.querySelector('#f-enabled:checked');

      const selectedProducts = Array.from(document.querySelectorAll('.product-checkbox:checked')).map(cb => (cb as HTMLInputElement).value);
      data.applicableProducts = selectedProducts;

      const method = id ? 'PUT' : 'POST';
      const url = id ? `/api/coupons/${id}` : '/api/coupons';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.error || 'Gagal menyimpan data');
      }

      window.location.reload();
    } catch (err: any) {
      alert(err.message);
      submitBtn.disabled = false;
      submitBtn.textContent = 'Simpan Kupon';
    }
  });

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      if (!confirm('Apakah Anda yakin ingin menghapus kupon ini?')) return;
      const el = e.currentTarget as HTMLElement;
      
      try {
        const res = await fetch(`/api/coupons/${el.dataset.id}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
        else alert('Gagal menghapus kupon');
      } catch (err) {
        alert('Terjadi kesalahan jaringan');
      }
    });
  });
</script>
