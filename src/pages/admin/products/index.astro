---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';
import { checkPermission } from '../../../lib/auth';

const canCreate = await checkPermission(Astro.cookies, 'products', 'create');
const canUpdate = await checkPermission(Astro.cookies, 'products', 'update');
const canDelete = await checkPermission(Astro.cookies, 'products', 'delete');

const search = Astro.url.searchParams.get('search') || '';
const category = Astro.url.searchParams.get('category') || '';
const status = Astro.url.searchParams.get('status') || '';
const pricingType = Astro.url.searchParams.get('pricingType') || '';
const featured = Astro.url.searchParams.get('featured') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 15;

const where: any = {};
if (search) where.name = { contains: search, mode: 'insensitive' };
if (category) where.categoryId = category;
if (status === 'published') where.isPublished = true;
if (status === 'draft') where.isPublished = false;
if (pricingType) where.pricingType = pricingType;
if (featured === 'yes') where.isFeatured = true;
if (featured === 'no') where.isFeatured = false;

const [products, total, categories] = await Promise.all([
  prisma.product.findMany({ where, include: { category: true }, orderBy: { createdAt: 'desc' }, skip: (page - 1) * limit, take: limit }),
  prisma.product.count({ where }),
  prisma.category.findMany({ orderBy: { name: 'asc' } }),
]);
const totalPages = Math.ceil(total / limit);
---
<AdminLayout title="Produk" currentPage="products">
  <div class="flex items-center justify-between mb-5">
    <form method="GET" class="flex flex-wrap gap-2 items-center">
      <input name="search" value={search} type="text" class="input-field text-sm py-2 w-64" placeholder="Cari produk..." />
      <select name="category" class="input-field text-sm py-2 w-auto min-w-[120px]">
        <option value="">Semua Kategori</option>
        {categories.map(cat => <option value={cat.id} selected={cat.id === category}>{cat.name}</option>)}
      </select>
      <select name="status" class="input-field text-sm py-2 w-auto">
        <option value="">Semua Status</option>
        <option value="published" selected={status === 'published'}>Published</option>
        <option value="draft" selected={status === 'draft'}>Draft</option>
      </select>
      <select name="pricingType" class="input-field text-sm py-2 w-auto">
        <option value="">Semua Tipe Harga</option>
        <option value="fixed" selected={pricingType === 'fixed'}>Fixed</option>
        <option value="area_m2" selected={pricingType === 'area_m2'}>Area M2</option>
        <option value="area_cm2" selected={pricingType === 'area_cm2'}>Area CM2</option>
        <option value="quantity" selected={pricingType === 'quantity'}>Kuantitas</option>
      </select>
      <select name="featured" class="input-field text-sm py-2 w-auto">
        <option value="">Semua Featured</option>
        <option value="yes" selected={featured === 'yes'}>Ya</option>
        <option value="no" selected={featured === 'no'}>Tidak</option>
      </select>
      <button type="submit" class="btn-primary text-sm py-2">Filter</button>
      {(search || category || status || pricingType || featured) && <a href="/admin/products" class="btn-ghost text-sm py-2">Reset</a>}
    </form>
    {canCreate && <a href="/admin/products/new" class="btn-primary text-sm">+ Tambah Produk</a>}
  </div>

  <div class="card">
    <div class="flex items-center justify-between p-5 border-b border-gray-50">
      <h2 class="font-bold text-gray-900">Daftar Produk <span class="badge-gray ml-2">{total}</span></h2>
    </div>
    <div class="table-wrapper">
      <table class="data-table">
        <thead><tr><th>Produk</th><th>Kategori</th><th>Harga</th><th>Status</th><th>Tipe Harga</th><th>Featured</th><th>Aksi</th></tr></thead>
        <tbody>
          {products.map(p => (
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-gray-100 overflow-hidden shrink-0">
                    {p.image ? <img src={p.image} alt={p.name} class="w-full h-full object-cover" /> : <div class="w-full h-full bg-blue-50"></div>}
                  </div>
                  <div>
                    <p class="font-medium text-sm text-gray-900">{p.name}</p>
                    <p class="text-xs text-gray-500 font-mono">{p.slug}</p>
                  </div>
                </div>
              </td>
              <td class="text-sm">{p.category?.name || '-'}</td>
              <td class="text-sm font-semibold">Rp {Number(p.price).toLocaleString('id')}</td>
              <td>{p.isPublished ? <span class="badge-green text-xs">Published</span> : <span class="badge-yellow text-xs">Draft</span>}</td>
              <td><span class="badge-blue text-xs">{p.pricingType}</span></td>
              <td>{p.isFeatured ? <span class="badge-green">Ya</span> : <span class="badge-gray">Tidak</span>}</td>
              <td>
                <div class="flex gap-2">
                  {canUpdate && <a href={`/admin/products/${p.id}`} class="text-blue-600 hover:underline text-xs font-medium">Edit</a>}
                  {canDelete && <button data-id={p.id} class="delete-product text-red-500 hover:underline text-xs font-medium">Hapus</button>}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {totalPages > 1 && (
      <div class="flex justify-center gap-2 p-4 border-t border-gray-50">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => {
          const params = new URLSearchParams();
          if (search) params.set('search', search);
          if (category) params.set('category', category);
          if (status) params.set('status', status);
          if (pricingType) params.set('pricingType', pricingType);
          if (featured) params.set('featured', featured);
          params.set('page', String(p));
          
          return (
            <a href={`/admin/products?${params}`} class={`w-8 h-8 rounded-lg flex items-center justify-center text-xs font-medium ${p === page ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>{p}</a>
          );
        })}
      </div>
    )}
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.delete-product').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Hapus produk ini?')) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/products/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload();
      else alert('Gagal menghapus produk');
    });
  });
</script>
