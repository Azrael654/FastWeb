---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';

const categories = await prisma.category.findMany({ orderBy: { name: 'asc' } });
---
<AdminLayout title="Tambah Produk" currentPage="products">
  <div class="mb-5">
    <a href="/admin/products" class="text-sm text-blue-600 hover:underline flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Kembali ke Produk
    </a>
  </div>

  <div class="max-w-3xl">
    <div class="card p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-6">Informasi Produk</h2>
      <div id="form-msg" class="hidden mb-4 p-3 rounded-lg text-sm"></div>
      <form id="product-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="label">Nama Produk *</label>
            <input name="name" required id="prod-name" class="input-field" placeholder="Banner Outdoor UV" />
          </div>
          <div>
            <label class="label">Slug</label>
            <input name="slug" id="prod-slug" class="input-field font-mono" placeholder="auto-generated" />
          </div>
        </div>

        <div>
          <label class="label">Deskripsi</label>
          <textarea name="description" id="prod-description" class="input-field" rows="3" placeholder="Deskripsi produk..."></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="label">Kategori *</label>
            <select name="categoryId" required class="input-field">
              <option value="">Pilih kategori...</option>
              {categories.map(c => <option value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div>
            <label class="label">Tipe Harga *</label>
            <select name="pricingType" id="pricing-type" class="input-field">
              <option value="fixed">Fixed (per item)</option>
              <option value="area_m2">Area m²</option>
              <option value="area_cm2">Area cm²</option>
              <option value="quantity">Per kuantitas</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="label">Harga Jual (Rp) *</label>
            <input name="price" type="number" min="0" step="100" required class="input-field" placeholder="25000" />
          </div>
          <div>
            <label class="label">Harga Dasar (Rp)</label>
            <input name="basePrice" type="number" min="0" step="100" class="input-field" placeholder="20000" />
          </div>

        </div>

        <div id="pricing-unit-wrap" class="hidden">
          <label class="label">Satuan Ukuran</label>
          <input name="pricingUnit" class="input-field" placeholder="m², cm², lembar..." />
        </div>

        <div>
          <label class="label">Galeri Gambar Produk</label>
          <div class="space-y-3">
            <div id="image-gallery" class="flex flex-wrap gap-3">
              <!-- Images rendered by JS -->
            </div>
            <div class="flex items-center gap-3">
              <label class="cursor-pointer bg-white border border-gray-200 hover:border-blue-500 text-gray-700 py-1.5 px-4 rounded-lg text-sm transition-colors shadow-sm inline-flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Unggah Gambar
                <input type="file" id="image-file" accept="image/*" multiple class="hidden" />
              </label>
              <button type="button" id="open-gallery-btn" class="bg-white border border-gray-200 hover:border-blue-500 text-gray-700 py-1.5 px-4 rounded-lg text-sm transition-colors shadow-sm inline-flex items-center gap-2">
                <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Pilih dari Galeri
              </button>
              <span id="uploading-msg" class="text-xs text-blue-600 hidden font-medium flex items-center gap-1.5">
                <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                Mengunggah...
              </span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <input type="checkbox" name="isFeatured" id="is-featured" value="true" class="w-4 h-4 text-blue-600 rounded" />
          <label for="is-featured" class="text-sm font-medium text-gray-700">Tampilkan sebagai produk unggulan di beranda</label>
        </div>

        <!-- Custom Options Builder -->
        <div class="border-t border-gray-100 pt-5">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="font-semibold text-gray-900 text-sm">Custom Fields / Pilihan Produk</h3>
              <p class="text-xs text-gray-500 mt-0.5">Tambahkan pilihan seperti Material, Finishing, Ukuran, dll.</p>
            </div>
            <button type="button" id="add-option-group" class="btn-ghost text-sm gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              Tambah Grup
            </button>
          </div>
          <div id="options-container" class="space-y-4"></div>
          <p id="no-options-msg" class="text-sm text-gray-400 italic py-3">Belum ada custom field. Klik "Tambah Grup" untuk menambahkan.</p>
        </div>

        <div class="pt-2 flex gap-3">
          <button type="submit" class="btn-primary px-8">Simpan Produk</button>
          <a href="/admin/products" class="btn-ghost">Batal</a>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<!-- EasyMDE for description -->
<link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
<script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>

<style is:global>
  #prod-description + .EasyMDEContainer .editor-toolbar { border-color: #e5e7eb !important; opacity: 1 !important; border-top-left-radius: 0.5rem !important; border-top-right-radius: 0.5rem !important; }
  #prod-description + .EasyMDEContainer .CodeMirror { border-color: #e5e7eb !important; border-bottom-left-radius: 0.5rem !important; border-bottom-right-radius: 0.5rem !important; font-size: 13px; min-height: 140px; }
</style>

<script>
  const nameInput = document.getElementById('prod-name') as HTMLInputElement;
  const slugInput = document.getElementById('prod-slug') as HTMLInputElement;
  const pricingType = document.getElementById('pricing-type') as HTMLSelectElement;

  // Init EasyMDE for description
  let descEditor: any;
  window.addEventListener('load', () => {
    if (typeof (window as any).EasyMDE !== 'undefined') {
      descEditor = new (window as any).EasyMDE({
        element: document.getElementById('prod-description'),
        spellChecker: false,
        placeholder: 'Deskripsi produk (mendukung **Markdown**)...',
        minHeight: '120px',
        maxHeight: '300px',
        toolbar: ['bold', 'italic', 'heading', '|', 'unordered-list', 'ordered-list', '|', 'link', 'preview'],
      });
    }
  });

  nameInput?.addEventListener('input', () => {
    slugInput.value = nameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  });

  pricingType?.addEventListener('change', () => {
    const isArea = pricingType.value.startsWith('area');
    document.getElementById('pricing-unit-wrap')?.classList.toggle('hidden', !isArea);
  });

  // --- Image Gallery Logic ---
  let imagesArray: string[] = [];
  const galleryContainer = document.getElementById('image-gallery')!;
  const imageInput = document.getElementById('image-file') as HTMLInputElement;
  const uploadingMsg = document.getElementById('uploading-msg')!;

  function renderGallery() {
    galleryContainer.innerHTML = '';
    if (imagesArray.length === 0) {
      galleryContainer.innerHTML = '<span class="text-xs text-gray-400 italic">Belum ada gambar</span>';
      return;
    }
    imagesArray.forEach((url, idx) => {
      const div = document.createElement('div');
      div.className = 'relative w-20 h-20 group rounded-lg overflow-hidden border border-gray-200 bg-gray-50';
      div.innerHTML = `
        <img src="${url}" class="w-full h-full object-cover" />
        ${idx === 0 ? '<span class="absolute top-0 left-0 bg-blue-600 text-white text-[9px] px-1.5 py-0.5 rounded-br-md font-medium z-10">Utama</span>' : ''}
        <button type="button" data-idx="${idx}" class="remove-img-btn absolute top-1 right-1 w-5 h-5 bg-white/90 text-red-500 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-50">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      `;
      galleryContainer.appendChild(div);
    });
    galleryContainer.querySelectorAll('.remove-img-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx!);
        imagesArray.splice(idx, 1);
        renderGallery();
      });
    });
  }

  imageInput?.addEventListener('change', async () => {
    if (!imageInput.files || imageInput.files.length === 0) return;
    
    uploadingMsg.classList.remove('hidden');
    imageInput.disabled = true;
    
    try {
      const files = Array.from(imageInput.files);
      for (const file of files) {
        const fd = new FormData();
        fd.append('file', file);
        const res = await fetch('/api/upload', { method: 'POST', body: fd });
        if (res.ok) {
          const data = await res.json();
          imagesArray.push(data.url);
        }
      }
      renderGallery();
    } catch (err) {
      alert('Gagal mengunggah beberapa gambar');
    } finally {
      imageInput.value = '';
      imageInput.disabled = false;
      uploadingMsg.classList.add('hidden');
    }
  });

  document.getElementById('open-gallery-btn')?.addEventListener('click', async () => {
    // @ts-ignore
    if (window.openMediaPicker) {
      // @ts-ignore
      const urls = await window.openMediaPicker({ multiple: true });
      if (urls && urls.length > 0) {
        imagesArray.push(...urls);
        renderGallery();
      }
    } else {
      alert('Media picker belum siap');
    }
  });

  renderGallery();
  // --- End Image Gallery Logic ---

  // --- Options Builder ---
  let optionGroups: { type: string; options: { name: string; priceAdj: string; isDefault: boolean }[] }[] = [];

  function renderGroups() {
    const container = document.getElementById('options-container')!;
    const msg = document.getElementById('no-options-msg')!;
    msg.classList.toggle('hidden', optionGroups.length > 0);
    container.innerHTML = '';
    optionGroups.forEach((group, gi) => {
      const groupEl = document.createElement('div');
      groupEl.className = 'border border-gray-200 rounded-xl p-4 space-y-3 bg-gray-50';
      groupEl.innerHTML = `
        <div class="flex items-center gap-3">
          <div class="flex-1">
            <label class="label text-xs">Nama Grup (Tipe)</label>
            <input type="text" placeholder="Contoh: Material, Finishing, Ukuran" value="${group.type}" data-gi="${gi}" data-field="type"
              class="group-type-input input-field text-sm py-2" />
          </div>
          <button type="button" data-gi="${gi}" class="remove-group-btn mt-5 p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
        <div class="space-y-2" id="opts-${gi}">
          ${group.options.map((opt, oi) => `
            <div class="flex items-center gap-2" data-oi="${oi}">
              <input type="text" placeholder="Nama pilihan" value="${opt.name}" data-gi="${gi}" data-oi="${oi}" data-field="name"
                class="opt-field input-field text-sm py-1.5 flex-1" />
              <div class="relative">
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs">+Rp</span>
                <input type="number" placeholder="0" value="${opt.priceAdj}" data-gi="${gi}" data-oi="${oi}" data-field="priceAdj"
                  class="opt-field input-field text-sm py-1.5 pl-9 w-28" />
              </div>
              <button type="button" data-gi="${gi}" data-oi="${oi}" class="remove-opt-btn p-1 text-gray-300 hover:text-red-500 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>`).join('')}
        </div>
        <button type="button" data-gi="${gi}" class="add-opt-btn text-xs text-blue-600 hover:underline font-medium flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Tambah Pilihan
        </button>
      `;
      container.appendChild(groupEl);
    });

    // Bind events
    container.querySelectorAll('.group-type-input').forEach(el => {
      el.addEventListener('input', (e) => {
        const gi = parseInt((e.target as HTMLElement).dataset.gi!);
        optionGroups[gi].type = (e.target as HTMLInputElement).value;
      });
    });
    container.querySelectorAll('.opt-field').forEach(el => {
      el.addEventListener('input', (e) => {
        const gi = parseInt((e.target as HTMLElement).dataset.gi!);
        const oi = parseInt((e.target as HTMLElement).dataset.oi!);
        const field = (e.target as HTMLElement).dataset.field as any;
        (optionGroups[gi].options[oi] as any)[field] = field === 'isDefault'
          ? (e.target as HTMLInputElement).checked
          : (e.target as HTMLInputElement).value;
      });
    });
    container.querySelectorAll('.remove-group-btn').forEach(el => {
      el.addEventListener('click', (e) => {
        const gi = parseInt((e.currentTarget as HTMLElement).dataset.gi!);
        optionGroups.splice(gi, 1);
        renderGroups();
      });
    });
    container.querySelectorAll('.add-opt-btn').forEach(el => {
      el.addEventListener('click', (e) => {
        const gi = parseInt((e.currentTarget as HTMLElement).dataset.gi!);
        optionGroups[gi].options.push({ name: '', priceAdj: '0', isDefault: false });
        renderGroups();
      });
    });
    container.querySelectorAll('.remove-opt-btn').forEach(el => {
      el.addEventListener('click', (e) => {
        const gi = parseInt((e.currentTarget as HTMLElement).dataset.gi!);
        const oi = parseInt((e.currentTarget as HTMLElement).dataset.oi!);
        optionGroups[gi].options.splice(oi, 1);
        renderGroups();
      });
    });
  }

  document.getElementById('add-option-group')?.addEventListener('click', () => {
    optionGroups.push({ type: '', options: [{ name: '', priceAdj: '0', isDefault: true }] });
    renderGroups();
  });

  renderGroups();
  // --- End Options Builder ---

  document.getElementById('product-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = document.getElementById('form-msg')!;
    const form = e.target as HTMLFormElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyimpan...';

    try {
      const fd = new FormData(form);
      const data: any = Object.fromEntries(fd);
      // Get description from EasyMDE
      if (descEditor) data.description = descEditor.value();
      
      data.imagesArray = imagesArray;
      data.image = imagesArray.length > 0 ? imagesArray[0] : null;

      data.isFeatured = fd.get('isFeatured') === 'true';

      data.isFeatured = fd.get('isFeatured') === 'true';
      data.price = parseFloat(data.price) || 0;
      data.basePrice = parseFloat(data.basePrice) || data.price;
      if (!data.slug) data.slug = data.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');

      // Collect options from builder
      const options = optionGroups
        .filter(g => g.type.trim())
        .flatMap(g => g.options
          .filter(o => o.name.trim())
          .map(o => ({ type: g.type.trim().toLowerCase(), name: o.name.trim(), priceAdj: parseFloat(o.priceAdj) || 0, isDefault: o.isDefault }))
        );
      data.options = options;

      const res = await fetch('/api/products', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) {
        window.location.href = '/admin/products';
      } else {
        const err = await res.json();
        throw new Error(err.error || 'Gagal menyimpan produk');
      }
    } catch (error: any) {
      msg.textContent = error.message || 'Terjadi kesalahan saat menyimpan produk';
      msg.className = 'mb-4 p-3 rounded-lg text-sm bg-red-50 text-red-700';
      msg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Simpan Produk';
    }
  });
</script>
