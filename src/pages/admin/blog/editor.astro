---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';
import MediaPicker from '../../../components/admin/MediaPicker.astro';
import { requireAdmin } from '../../../lib/auth';

const user = requireAdmin(Astro.cookies);
if (!user) return Astro.redirect('/login');

const id = Astro.url.searchParams.get('id');
let post = null;

if (id) {
  post = await prisma.blogPost.findUnique({ where: { id } });
  if (!post) return Astro.redirect('/admin/blog');
}

const categories = await prisma.blogCategory.findMany({ orderBy: { name: 'asc' } });
---
<AdminLayout title={post ? 'Edit Artikel' : 'Tulis Artikel'} currentPage="blog">
  <div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-3">
      <a href="/admin/blog" class="w-8 h-8 flex items-center justify-center bg-white rounded-lg border border-gray-200 text-gray-500 hover:text-gray-900 hover:bg-gray-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <h2 class="text-lg font-bold text-gray-900">{post ? 'Edit Artikel' : 'Tulis Artikel Baru'}</h2>
    </div>
  </div>

  <div class="card p-6">
    <form id="post-form" class="space-y-4">
      <input type="hidden" name="id" value={post?.id || ''} />
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="label">Judul *</label>
          <input name="title" required class="input-field" id="post-title" value={post?.title || ''} />
        </div>
        <div>
          <label class="label">Slug</label>
          <input name="slug" id="post-slug" class="input-field font-mono text-sm" placeholder="auto-generated" value={post?.slug || ''} />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="label">Kategori</label>
          <select name="category" class="input-field">
            <option value="">-- Tanpa Kategori --</option>
            {categories.map(c => (
              <option value={c.name} selected={post?.category === c.name}>{c.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="label">Penulis</label>
          <input name="author" class="input-field bg-gray-50 text-gray-500 cursor-not-allowed" value={post?.author || user.name} readonly />
        </div>
      </div>

      <div>
        <label class="label">Ringkasan Singkat</label>
        <textarea name="excerpt" class="input-field" rows="2">{post?.excerpt || ''}</textarea>
      </div>

      <div>
        <label class="label">Gambar Sampul</label>
        <input type="hidden" name="image" id="image-url" value={post?.image || ''} />

        <!-- Preview -->
        <div id="blog-img-preview" class={`mb-2 relative inline-block ${post?.image ? '' : 'hidden'}`}>
          <img id="blog-img-thumb" src={post?.image || ''} alt="Preview" class="w-16 h-16 rounded-lg object-cover border border-gray-200" />
          <button type="button" id="blog-img-clear" class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-red-500 text-white rounded-full flex items-center justify-center hover:bg-red-600 shadow">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="flex gap-2">
          <label class="flex-1 btn-ghost text-sm cursor-pointer flex items-center justify-center gap-2 py-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            Unggah File
            <input type="file" id="image-file" accept="image/*" class="hidden" />
          </label>
          <button type="button" id="open-gallery-blog" class="flex-1 btn-ghost text-sm flex items-center justify-center gap-2 py-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Pilih dari Galeri
          </button>
        </div>
      </div>

      <div>
        <label class="label">Konten *</label>
        <textarea name="content" id="markdown-editor">{post?.content || ''}</textarea>
      </div>

      <div class="flex items-center gap-2 pt-2 border-t border-gray-100">
        <input type="checkbox" name="published" id="published" value="true" class="w-4 h-4 text-blue-600 rounded" checked={post?.published || false} />
        <label for="published" class="text-sm font-medium text-gray-700">Publikasikan sekarang</label>
      </div>

      <div class="flex justify-end pt-4">
        <button type="submit" class="btn-primary">Simpan Artikel</button>
      </div>
    </form>
  </div>
  <MediaPicker />
</AdminLayout>

<!-- Load EasyMDE for WYSIWYG Markdown Editing -->
<link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
<script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>

<style is:global>
  .editor-toolbar { border-color: #e5e7eb !important; opacity: 1 !important; border-top-left-radius: 0.5rem !important; border-top-right-radius: 0.5rem !important; }
  .CodeMirror { border-color: #e5e7eb !important; border-bottom-left-radius: 0.5rem !important; border-bottom-right-radius: 0.5rem !important; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; font-size: 14px; }
  .editor-statusbar { padding: 8px 12px !important; }
</style>

<script>
  // Initialize EasyMDE
  let easyMDE: any;
  
  // Wait for the script to load completely
  window.addEventListener('load', () => {
    if (typeof (window as any).EasyMDE !== 'undefined') {
      easyMDE = new (window as any).EasyMDE({
        element: document.getElementById('markdown-editor'),
        spellChecker: false,
        placeholder: "Tulis konten artikel di sini...",
        minHeight: "400px",
        maxHeight: "600px",
      });
    }
  });

  const titleInput = document.getElementById('post-title') as HTMLInputElement;
  const slugInput  = document.getElementById('post-slug') as HTMLInputElement;

  // ── Image helpers ────────────────────────────────────────────────────────────
  function setBlogImage(url: string) {
    (document.getElementById('image-url') as HTMLInputElement).value = url;
    const preview = document.getElementById('blog-img-preview')!;
    const thumb   = document.getElementById('blog-img-thumb') as HTMLImageElement;
    if (url) {
      thumb.src = url;
      preview.classList.remove('hidden');
    } else {
      preview.classList.add('hidden');
    }
  }

  document.getElementById('blog-img-clear')?.addEventListener('click', () => {
    setBlogImage('');
    (document.getElementById('image-file') as HTMLInputElement).value = '';
  });

  document.getElementById('image-file')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => setBlogImage(ev.target?.result as string);
    reader.readAsDataURL(file);
  });

  document.getElementById('open-gallery-blog')?.addEventListener('click', async () => {
    const urls = await (window as any).openMediaPicker({ multiple: false });
    if (urls && urls.length > 0) setBlogImage(urls[0]);
  });

  // Auto-generate slug from title if slug is empty or it's a new post
  titleInput?.addEventListener('input', (e) => {
    if (!document.querySelector('input[name="id"]')?.getAttribute('value')) {
      const val = (e.target as HTMLInputElement).value;
      slugInput.value = val.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }
  });

  document.getElementById('post-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyimpan...';

    try {
      const fd = new FormData(form);
      const data: any = Object.fromEntries(fd);
      
      // Update content from EasyMDE
      if (easyMDE) {
        data.content = easyMDE.value();
      }
      
      if (!data.content || data.content.trim() === '') {
        throw new Error('Konten artikel tidak boleh kosong');
      }

      // Handle file upload
      const fileInput = document.getElementById('image-file') as HTMLInputElement;
      if (fileInput.files && fileInput.files.length > 0) {
        const uploadFd = new FormData();
        uploadFd.append('file', fileInput.files[0]);
        const uploadRes = await fetch('/api/upload', { method: 'POST', body: uploadFd });
        if (uploadRes.ok) {
          const uploadData = await uploadRes.json();
          data.image = uploadData.url;
        } else {
          throw new Error('Gagal mengunggah gambar');
        }
      }

      data.published = fd.get('published') === 'true';
      if (!data.slug) data.slug = data.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      
      const isEdit = !!data.id;
      const url = isEdit ? `/api/blog/${data.id}` : '/api/blog';
      const method = isEdit ? 'PUT' : 'POST';
      
      const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) {
        window.location.href = '/admin/blog';
      } else { 
        const err = await res.json(); 
        throw new Error(err.error || 'Gagal menyimpan artikel'); 
      }
    } catch (error: any) {
      alert(error.message || 'Terjadi kesalahan');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Simpan Artikel';
    }
  });
</script>
