---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';

const posts = await prisma.blogPost.findMany({ orderBy: { date: 'desc' } });
const categories = await prisma.blogCategory.findMany({ orderBy: { name: 'asc' } });
---
<AdminLayout title="Blog" currentPage="blog">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Artikel Blog</h2>
      <p class="text-sm text-gray-500">{posts.length} artikel</p>
    </div>
    <div class="flex gap-2">
      <button id="manage-category-btn" class="btn-ghost border border-gray-200 text-sm">Kelola Kategori</button>
      <a href="/admin/blog/editor" class="btn-primary text-sm">+ Tulis Artikel</a>
    </div>
  </div>

  <div class="card mb-8">
    <div class="table-wrapper">
      <table class="data-table">
        <thead><tr><th>Judul</th><th>Kategori</th><th>Penulis</th><th>Tanggal</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody>
          {posts.map(p => (
            <tr>
              <td>
                <p class="font-medium text-sm text-gray-900">{p.title}</p>
                <p class="text-xs text-gray-400 font-mono">{p.slug}</p>
              </td>
              <td class="text-sm text-gray-600">{p.category || '-'}</td>
              <td class="text-sm text-gray-600">{p.author}</td>
              <td class="text-xs text-gray-500">{new Date(p.date).toLocaleDateString('id-ID')}</td>
              <td>{p.published ? <span class="badge-green text-xs">Publik</span> : <span class="badge-gray text-xs">Draft</span>}</td>
              <td>
                <div class="flex items-center gap-3">
                  <a href={`/blog/${p.slug}`} target="_blank" class="text-blue-600 hover:text-blue-800 text-xs">Lihat</a>
                  <a href={`/admin/blog/editor?id=${p.id}`} class="text-yellow-600 hover:text-yellow-800 text-xs">Edit</a>
                  <button data-id={p.id} class="delete-post text-red-500 hover:text-red-700 text-xs">Hapus</button>
                </div>
              </td>
            </tr>
          ))}
          {posts.length === 0 && <tr><td colspan="6" class="text-center py-8 text-gray-400">Belum ada artikel</td></tr>}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Category Modal -->
  <div id="category-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-lg shadow-xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 class="font-bold text-gray-900 text-lg">Kelola Kategori Blog</h3>
        <button id="close-category-modal" class="text-gray-400 hover:text-gray-600">&times;</button>
      </div>
      
      <form id="category-form" class="flex items-end gap-2 mb-6">
        <input type="hidden" name="id" id="cat-id" />
        <div class="flex-1">
          <label class="label text-xs">Nama Kategori</label>
          <input name="name" id="cat-name" required class="input-field text-sm" placeholder="Misal: Tips Cetak" />
        </div>
        <button type="submit" class="btn-primary text-sm px-4 py-2.5 h-[42px]">Simpan</button>
      </form>

      <div class="space-y-2">
        {categories.map(c => (
          <div class="flex items-center justify-between p-2.5 bg-gray-50 rounded-lg group">
            <div>
              <p class="font-medium text-sm text-gray-900">{c.name}</p>
            </div>
            <div class="opacity-0 group-hover:opacity-100 transition-opacity flex gap-2">
              <button class="edit-cat-btn text-xs text-blue-600 hover:underline" data-id={c.id} data-name={c.name}>Edit</button>
              <button class="delete-cat-btn text-xs text-red-600 hover:underline" data-id={c.id}>Hapus</button>
            </div>
          </div>
        ))}
        {categories.length === 0 && <p class="text-sm text-center text-gray-400">Belum ada kategori</p>}
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Category Modal Logic
  const catModal = document.getElementById('category-modal')!;
  const catForm = document.getElementById('category-form') as HTMLFormElement;
  const catIdInput = document.getElementById('cat-id') as HTMLInputElement;

  document.getElementById('manage-category-btn')?.addEventListener('click', () => {
    catForm.reset();
    catIdInput.value = '';
    catModal.classList.remove('hidden');
  });

  document.getElementById('close-category-modal')?.addEventListener('click', () => {
    catModal.classList.add('hidden');
  });

  document.querySelectorAll('.edit-cat-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      catIdInput.value = el.dataset.id!;
      (document.getElementById('cat-name') as HTMLInputElement).value = el.dataset.name!;
    });
  });

  document.querySelectorAll('.delete-cat-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      if (!confirm('Yakin ingin menghapus kategori ini?')) return;
      const el = e.currentTarget as HTMLElement;
      const res = await fetch(`/api/blog/categories/${el.dataset.id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else alert('Gagal menghapus kategori');
    });
  });

  catForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(catForm));
    const isEdit = !!data.id;
    const url = isEdit ? `/api/blog/categories/${data.id}` : '/api/blog/categories';
    const method = isEdit ? 'PUT' : 'POST';
    
    const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
    if (res.ok) location.reload(); else alert('Gagal menyimpan kategori');
  });

  document.querySelectorAll('.delete-post').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      if (!confirm('Hapus artikel ini secara permanen?')) return;
      const id = (e.currentTarget as HTMLElement).dataset.id;
      const res = await fetch(`/api/blog/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else alert('Gagal menghapus artikel');
    });
  });
</script>
