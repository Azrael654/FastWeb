---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';
import { getSessionUser } from '../../../lib/auth';

const currentUserData = Astro.locals.user as any;
const currentUser = currentUserData;
const canAdd = currentUserData?.isSystem || currentUserData?.permissions?.users?.add;
const canEdit = currentUserData?.isSystem || currentUserData?.permissions?.users?.edit;
const canDelete = currentUserData?.isSystem || currentUserData?.permissions?.users?.delete;

const q    = Astro.url.searchParams.get('q') || '';
const role = Astro.url.searchParams.get('role') || '';

const [users, roles, totalUsers] = await Promise.all([
  prisma.appUser.findMany({
    where: {
      ...(q ? { OR: [
        { name:  { contains: q, mode: 'insensitive' } },
        { email: { contains: q, mode: 'insensitive' } },
      ]} : {}),
      ...(role ? { role } : {}),
    },
    orderBy: { createdAt: 'desc' },
    select: { id: true, name: true, email: true, role: true, phone: true, createdAt: true }
  }),
  prisma.role.findMany({ orderBy: { name: 'asc' } }),
  prisma.appUser.count(),
]);

const SYSTEM_ROLES = ['admin', 'customer'];

// Modules & their actions for the permission matrix
const MODULES = [
  { key: 'orders',    label: 'Pesanan' },
  { key: 'products',  label: 'Produk' },
  { key: 'inventory', label: 'Inventori' },
  { key: 'finance',   label: 'Keuangan' },
  { key: 'blog',      label: 'Blog' },
  { key: 'coupons',   label: 'Kupon' },
  { key: 'crm',       label: 'CRM' },
  { key: 'users',     label: 'Pengguna' },
  { key: 'popups',    label: 'Popup' },
  { key: 'gallery',   label: 'Galeri Media' },
  { key: 'config',    label: 'Konfigurasi' },
];
const ACTIONS = ['view', 'add', 'edit', 'delete'];
const ACTION_LABELS: {[k:string]:string} = { view: 'Lihat', add: 'Tambah', edit: 'Edit', delete: 'Hapus' };

// Pre-process roles so templates never need TS generics with angle-bracket syntax
type PermMap = {[mod:string]:{[action:string]:boolean}};
const rolesWithMeta = roles.map(r => ({
  ...r,
  isSystem: SYSTEM_ROLES.includes(r.name) || r.isSystem,
  perms:    (r.permissions || {}) as PermMap,
  permJson: JSON.stringify(r),
}));
---

<AdminLayout title="Pengguna" currentPage="users">
  <!-- Tab Bar -->
  <div class="flex gap-1 mb-6 bg-gray-100 rounded-xl p-1 w-fit">
    <button id="tab-users-btn"
      class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-white text-blue-700 shadow-sm"
      >Daftar Pengguna</button>
    <button id="tab-roles-btn"
      class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-gray-500 hover:text-gray-700"
      >Manajemen Role</button>
  </div>

  <!-- ===== TAB: PENGGUNA ===== -->
  <div id="tab-users">
    <div class="flex items-center justify-between mb-4">
      <p class="text-sm text-gray-500">{(q||role) ? `${users.length} dari ${totalUsers}` : `${totalUsers} pengguna`}</p>
      {canAdd && (
        <button id="add-user-btn" class="btn-primary text-sm">+ Tambah Pengguna</button>
      )}
    </div>
    <div class="card">
      <div class="p-4 border-b border-gray-100 bg-gray-50/50 flex gap-3 flex-wrap">
        <form action="/admin/users" method="GET" id="search-form" class="flex gap-3 flex-1 flex-wrap">
          <div class="relative flex-1 min-w-[180px]">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="search" name="q" value={q} placeholder="Cari nama / email..." class="input-field w-full pl-9 py-2 text-sm" />
          </div>
          <select name="role" class="input-field text-sm py-2" onchange="document.getElementById('search-form').submit()">
            <option value="">Semua Role</option>
            {roles.map(r => <option value={r.name} selected={role===r.name}>{r.name}</option>)}
          </select>
          <button type="submit" class="btn-primary text-sm py-2 px-4">Cari</button>
          {(q||role) && <a href="/admin/users" class="btn-ghost text-sm py-2 px-4">Reset</a>}
        </form>
      </div>
      <div class="table-wrapper">
        <table class="data-table">
          <thead><tr><th>Pengguna</th><th>Email</th><th>Telepon</th><th>Role</th><th>Bergabung</th><th class="text-right">Aksi</th></tr></thead>
          <tbody>
            {users.length === 0 ? (
              <tr><td colspan="6" class="text-center py-10 text-sm text-gray-400">Tidak ada pengguna ditemukan</td></tr>
            ) : users.map(u => (
              <tr>
                <td>
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
                      <span class="text-xs font-bold text-blue-700">{u.name.charAt(0).toUpperCase()}</span>
                    </div>
                    <span class="font-medium text-sm">{u.name}</span>
                    {currentUser?.id === u.id && <span class="badge-blue text-[10px] ml-1">Anda</span>}
                  </div>
                </td>
                <td class="text-sm text-gray-600">{u.email}</td>
                <td class="text-sm text-gray-600">{u.phone || '-'}</td>
                <td><span class={u.role==='admin'?'badge-blue':u.role==='customer'?'badge-green':'badge-gray'}>{u.role}</span></td>
                <td class="text-xs text-gray-500">{new Date(u.createdAt).toLocaleDateString('id-ID')}</td>
                <td class="text-right">
                  <div class="flex items-center justify-end gap-2">
                    {canEdit && (
                      <button class="edit-user-btn p-1.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                        data-id={u.id} data-name={u.name} data-email={u.email} data-phone={u.phone||''} data-role={u.role} title="Edit">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                      </button>
                    )}
                    {(canDelete && currentUser?.id !== u.id) && (
                      <button class="delete-user-btn p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                        data-id={u.id} title="Hapus">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ===== TAB: MANAJEMEN ROLE ===== -->
  <div id="tab-roles" class="hidden">
    <div class="flex items-center justify-between mb-4">
      <p class="text-sm text-gray-500">Role sistem (<code class="bg-gray-100 px-1 rounded text-xs">admin</code>, <code class="bg-gray-100 px-1 rounded text-xs">customer</code>) tidak dapat diubah.</p>
      {canAdd && (
        <button id="add-role-btn" class="btn-primary text-sm">+ Buat Role Baru</button>
      )}
    </div>

    <div class="space-y-4">
    {rolesWithMeta.map(r => {
        const { isSystem, perms, permJson } = r;
        return (
          <div class="card p-5">
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class={`w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm ${isSystem ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}`}>
                  {r.name.charAt(0).toUpperCase()}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-gray-900 capitalize">{r.name}</span>
                    {isSystem && <span class="text-[10px] bg-blue-100 text-blue-600 px-2 py-0.5 rounded-full font-medium">Sistem</span>}
                  </div>
                  <p class="text-xs text-gray-500 mt-0.5">{r.description || 'Tanpa deskripsi'}</p>
                </div>
              </div>
              {!isSystem && (
                <div class="flex gap-2">
                  {canEdit && (
                    <button class="edit-role-btn text-xs text-blue-600 hover:text-blue-800 font-medium"
                      data-role={permJson}>Edit</button>
                  )}
                  {canDelete && (
                    <button class="delete-role-btn text-xs text-red-500 hover:text-red-700 font-medium"
                      data-id={r.id} data-name={r.name}>Hapus</button>
                  )}
                </div>
              )}
            </div>

            {isSystem ? (
              <p class="text-xs text-gray-400 italic">Role sistem memiliki akses penuh ke semua fitur admin.</p>
            ) : (
              <div class="overflow-x-auto">
                <table class="w-full text-xs border-collapse">
                  <thead>
                    <tr class="bg-gray-50">
                      <th class="text-left px-3 py-2 text-gray-600 font-medium w-32 border border-gray-200">Modul</th>
                      {ACTIONS.map(a => (
                        <th class="px-3 py-2 text-center text-gray-600 font-medium border border-gray-200 w-20">{ACTION_LABELS[a]}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {MODULES.map(m => (
                      <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-3 py-2 font-medium text-gray-700 border border-gray-200">{m.label}</td>
                        {ACTIONS.map(a => {
                          const allowed = perms?.[m.key]?.[a] === true;
                          return (
                            <td class="px-3 py-2 text-center border border-gray-200">
                              {allowed
                                ? <span class="inline-block w-4 h-4 bg-green-500 rounded-full mx-auto"></span>
                                : <span class="inline-block w-4 h-4 bg-gray-200 rounded-full mx-auto"></span>}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>

  <!-- Modal: Add/Edit User -->
  <div id="user-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-xl">
      <h3 id="user-modal-title" class="font-bold text-gray-900 text-lg mb-4">Tambah Pengguna</h3>
      <form id="user-form" class="space-y-4">
        <input type="hidden" id="user-id" name="id" />
        <div><label class="label">Nama Lengkap *</label><input type="text" id="user-name" name="name" required class="input-field text-sm" /></div>
        <div><label class="label">Email *</label><input type="email" id="user-email" name="email" required class="input-field text-sm" /></div>
        <div><label class="label">No. Telepon</label><input type="tel" id="user-phone" name="phone" class="input-field text-sm" /></div>
        <div>
          <label class="label">Role *</label>
          <select id="user-role" name="role" required class="input-field text-sm">
            {roles.map(r => <option value={r.name}>{r.name.charAt(0).toUpperCase()+r.name.slice(1)}</option>)}
          </select>
        </div>
        <div>
          <label class="label" id="pwd-label">Password *</label>
          <input type="password" id="user-password" name="password" class="input-field text-sm" />
          <p id="pwd-hint" class="hidden text-xs text-gray-400 mt-1">Kosongkan jika tidak ingin mengubah password.</p>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="btn-primary flex-1 text-sm">Simpan</button>
          <button type="button" id="close-user-modal" class="btn-ghost flex-1 text-sm">Batal</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Add/Edit Role -->
  <div id="role-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-3xl shadow-xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-5">
        <h3 id="role-modal-title" class="font-bold text-gray-900 text-lg">Buat Role Baru</h3>
        <button id="close-role-modal" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>
      </div>
      <form id="role-form" class="space-y-5">
        <input type="hidden" id="role-id" />
        <div class="grid grid-cols-2 gap-4">
          <div><label class="label">Nama Role *</label><input id="role-name" required class="input-field text-sm" placeholder="operator, editor..." /></div>
          <div><label class="label">Deskripsi</label><input id="role-desc" class="input-field text-sm" placeholder="Deskripsi singkat..." /></div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-3">
            <h4 class="font-semibold text-gray-800 text-sm">Hak Akses per Modul</h4>
            <div class="flex gap-2">
              <button type="button" id="check-all-btn" class="text-xs text-blue-600 hover:underline">Centang Semua</button>
              <span class="text-gray-300">|</span>
              <button type="button" id="uncheck-all-btn" class="text-xs text-gray-500 hover:underline">Hapus Semua</button>
            </div>
          </div>
          <div class="overflow-x-auto rounded-xl border border-gray-200">
            <table class="w-full text-sm border-collapse" id="perm-table">
              <thead>
                <tr class="bg-gray-50">
                  <th class="text-left px-4 py-3 text-gray-600 font-medium w-36 border-b border-gray-200">Modul</th>
                  {ACTIONS.map(a => (
                    <th class="px-4 py-3 text-center text-gray-600 font-medium border-b border-gray-200">
                      <div class="flex flex-col items-center gap-1">
                        <span>{ACTION_LABELS[a]}</span>
                        <button type="button" class="col-check-all text-[10px] text-blue-500 hover:underline" data-action={a}>Semua</button>
                      </div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {MODULES.map(m => (
                  <tr class="hover:bg-gray-50 border-b border-gray-100 last:border-0">
                    <td class="px-4 py-3 font-medium text-gray-700">{m.label}</td>
                    {ACTIONS.map(a => (
                      <td class="px-4 py-3 text-center">
                        <input type="checkbox" class="perm-checkbox w-4 h-4 text-blue-600 rounded cursor-pointer"
                          data-module={m.key} data-action={a}
                          id={`perm-${m.key}-${a}`} />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="flex gap-3 pt-2">
          <button type="submit" class="btn-primary flex-1" id="role-submit-btn">Simpan Role</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  // ── Tab switching ─────────────────────────────────────────────────────────
  function switchTab(tab: string) {
    const tabs = ['users', 'roles'];
    tabs.forEach(t => {
      document.getElementById(`tab-${t}`)?.classList.toggle('hidden', t !== tab);
      const btn = document.getElementById(`tab-${t}-btn`);
      if (btn) {
        btn.className = t === tab
          ? 'tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all bg-white text-blue-700 shadow-sm'
          : 'tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-gray-500 hover:text-gray-700';
      }
    });
  }

  document.getElementById('tab-users-btn')?.addEventListener('click', () => switchTab('users'));
  document.getElementById('tab-roles-btn')?.addEventListener('click', () => switchTab('roles'));

  // ── User Modal ───────────────────────────────────────────────────────────────
  const userModal = document.getElementById('user-modal')!;
  const userForm  = document.getElementById('user-form') as HTMLFormElement;

  function openUserModal(isEdit = false, data: any = {}) {
    userForm.reset();
    (document.getElementById('user-id') as HTMLInputElement).value        = data.id    || '';
    (document.getElementById('user-name') as HTMLInputElement).value      = data.name  || '';
    (document.getElementById('user-email') as HTMLInputElement).value     = data.email || '';
    (document.getElementById('user-phone') as HTMLInputElement).value     = data.phone || '';
    (document.getElementById('user-role') as HTMLSelectElement).value     = data.role  || 'customer';
    document.getElementById('user-modal-title')!.textContent = isEdit ? 'Edit Pengguna' : 'Tambah Pengguna';
    const pwdInput = document.getElementById('user-password') as HTMLInputElement;
    const pwdLabel = document.getElementById('pwd-label')!;
    const pwdHint  = document.getElementById('pwd-hint')!;
    if (isEdit) { pwdInput.required=false; pwdLabel.textContent='Password Baru'; pwdHint.classList.remove('hidden'); }
    else        { pwdInput.required=true;  pwdLabel.textContent='Password *';    pwdHint.classList.add('hidden'); }
    userModal.classList.remove('hidden');
  }

  document.getElementById('add-user-btn')?.addEventListener('click', () => openUserModal(false));
  document.getElementById('close-user-modal')?.addEventListener('click', () => userModal.classList.add('hidden'));
  userModal.addEventListener('click', e => { if (e.target === userModal) userModal.classList.add('hidden'); });

  document.querySelectorAll('.edit-user-btn').forEach(btn => {
    btn.addEventListener('click', () => openUserModal(true, (btn as HTMLElement).dataset));
  });

  document.querySelectorAll('.delete-user-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Hapus pengguna ini?')) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else alert((await res.json()).error || 'Gagal menghapus');
    });
  });

  userForm?.addEventListener('submit', async e => {
    e.preventDefault();
    const fd = new FormData(userForm);
    const data: any = Object.fromEntries(fd);
    const id = data.id; if (!id) delete data.id;
    if (id && !data.password) delete data.password;
    const res = await fetch(id ? `/api/users/${id}` : '/api/users', {
      method: id ? 'PUT' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) location.reload(); else alert((await res.json()).error || 'Gagal menyimpan');
  });

  // ── Role Modal ───────────────────────────────────────────────────────────────
  const roleModal = document.getElementById('role-modal')!;
  const roleForm  = document.getElementById('role-form') as HTMLFormElement;

  function setCheckboxes(perms: Record<string, Record<string, boolean>>) {
    document.querySelectorAll<HTMLInputElement>('.perm-checkbox').forEach(cb => {
      const mod = cb.dataset.module!;
      const act = cb.dataset.action!;
      cb.checked = perms?.[mod]?.[act] === true;
    });
  }

  function readPermissions(): Record<string, Record<string, boolean>> {
    const perms: Record<string, Record<string, boolean>> = {};
    document.querySelectorAll<HTMLInputElement>('.perm-checkbox').forEach(cb => {
      const mod = cb.dataset.module!;
      const act = cb.dataset.action!;
      if (!perms[mod]) perms[mod] = {};
      perms[mod][act] = cb.checked;
    });
    return perms;
  }

  function openRoleModal(data?: any) {
    roleForm.reset();
    (document.getElementById('role-id') as HTMLInputElement).value   = data?.id   || '';
    (document.getElementById('role-name') as HTMLInputElement).value = data?.name || '';
    (document.getElementById('role-desc') as HTMLInputElement).value = data?.description || '';
    document.getElementById('role-modal-title')!.textContent = data?.id ? 'Edit Role' : 'Buat Role Baru';
    setCheckboxes(data?.permissions || {});
    roleModal.classList.remove('hidden');
  }

  document.getElementById('add-role-btn')?.addEventListener('click', () => openRoleModal());
  document.getElementById('close-role-modal')?.addEventListener('click', () => roleModal.classList.add('hidden'));
  roleModal.addEventListener('click', e => { if (e.target === roleModal) roleModal.classList.add('hidden'); });

  document.querySelectorAll('.edit-role-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const data = JSON.parse((btn as HTMLElement).dataset.role!);
      openRoleModal(data);
    });
  });

  document.querySelectorAll('.delete-role-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      if (!confirm(`Hapus role "${el.dataset.name}"?`)) return;
      const res = await fetch(`/api/roles/${el.dataset.id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else alert((await res.json()).error || 'Gagal menghapus');
    });
  });

  // Check-all / uncheck-all helpers
  document.getElementById('check-all-btn')?.addEventListener('click', () =>
    document.querySelectorAll<HTMLInputElement>('.perm-checkbox').forEach(cb => cb.checked = true));
  document.getElementById('uncheck-all-btn')?.addEventListener('click', () =>
    document.querySelectorAll<HTMLInputElement>('.perm-checkbox').forEach(cb => cb.checked = false));

  document.querySelectorAll('.col-check-all').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = (btn as HTMLElement).dataset.action!;
      document.querySelectorAll<HTMLInputElement>(`.perm-checkbox[data-action="${action}"]`)
        .forEach(cb => cb.checked = true);
    });
  });

  roleForm?.addEventListener('submit', async e => {
    e.preventDefault();
    const submitBtn = document.getElementById('role-submit-btn') as HTMLButtonElement;
    submitBtn.disabled = true; submitBtn.textContent = 'Menyimpan...';
    const id   = (document.getElementById('role-id') as HTMLInputElement).value;
    const name = (document.getElementById('role-name') as HTMLInputElement).value.trim();
    const desc = (document.getElementById('role-desc') as HTMLInputElement).value.trim();
    const permissions = readPermissions();
    try {
      const res = await fetch(id ? `/api/roles/${id}` : '/api/roles', {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description: desc, permissions })
      });
      if (res.ok) location.reload(); else alert((await res.json()).error || 'Gagal menyimpan');
    } finally {
      submitBtn.disabled = false; submitBtn.textContent = 'Simpan Role';
    }
  });
</script>
