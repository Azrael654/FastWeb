---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';
import { getSessionUser } from '../../../lib/auth';

const currentUser = getSessionUser(Astro.cookies);

const q    = Astro.url.searchParams.get('q') || '';
const role = Astro.url.searchParams.get('role') || '';

const users = await prisma.appUser.findMany({
  where: {
    ...(q ? {
      OR: [
        { name:  { contains: q, mode: 'insensitive' } },
        { email: { contains: q, mode: 'insensitive' } },
        { phone: { contains: q, mode: 'insensitive' } },
      ]
    } : {}),
    ...(role ? { role } : {}),
  },
  orderBy: { createdAt: 'desc' },
  select: { id: true, name: true, email: true, role: true, phone: true, createdAt: true }
});

const availableRoles = await prisma.role.findMany({ orderBy: { name: 'asc' } });
const totalUsers = await prisma.appUser.count();
---
<AdminLayout title="Pengguna" currentPage="users">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Manajemen Pengguna</h2>
      <p class="text-sm text-gray-500">
        {(q || role) ? `${users.length} dari ${totalUsers} pengguna` : `${totalUsers} pengguna terdaftar`}
      </p>
    </div>
    <div class="flex gap-3">
      <a href="/admin/roles" class="btn-ghost text-sm">Kelola Role</a>
      <button id="add-user-btn" class="btn-primary text-sm">+ Tambah Pengguna</button>
    </div>
  </div>

  <div class="card">
    <!-- Search & Filter Bar -->
    <div class="p-4 border-b border-gray-100 bg-gray-50/50 flex flex-col sm:flex-row gap-3">
      <form action="/admin/users" method="GET" id="search-form" class="flex gap-3 flex-1 flex-wrap sm:flex-nowrap">
        <div class="relative flex-1 min-w-[200px]">
          <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            type="search"
            name="q"
            value={q}
            placeholder="Cari nama, email, atau telepon..."
            class="input-field w-full pl-9 pr-4 py-2 text-sm"
          />
        </div>
        <select
          name="role"
          class="input-field text-sm py-2 min-w-[130px]"
          onchange="document.getElementById('search-form').submit()"
        >
          <option value="" selected={!role}>Semua Role</option>
          {availableRoles.map(r => (
            <option value={r.name} selected={role === r.name}>
              {r.name.charAt(0).toUpperCase() + r.name.slice(1)}
            </option>
          ))}
        </select>
        <button type="submit" class="btn-primary text-sm py-2 px-4">Cari</button>
        {(q || role) && (
          <a href="/admin/users" class="btn-ghost text-sm py-2 px-4 text-gray-600">Reset</a>
        )}
      </form>
    </div>

    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Pengguna</th>
            <th>Email</th>
            <th>Telepon</th>
            <th>Role</th>
            <th>Bergabung</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          {users.length === 0 ? (
            <tr>
              <td colspan="6" class="text-center py-10 text-sm text-gray-500">
                <svg class="w-10 h-10 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Tidak ada pengguna yang sesuai dengan pencarian Anda.
              </td>
            </tr>
          ) : users.map(u => (
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
                    <span class="text-xs font-bold text-blue-700">{u.name.charAt(0).toUpperCase()}</span>
                  </div>
                  <span class="font-medium text-sm text-gray-900">{u.name}</span>
                  {currentUser?.id === u.id && <span class="badge-blue text-[10px] ml-2">Anda</span>}
                </div>
              </td>
              <td class="text-sm text-gray-600">{u.email}</td>
              <td class="text-sm text-gray-600">{u.phone || '-'}</td>
              <td>
                <span class={u.role === 'admin' ? 'badge-blue' : u.role === 'customer' ? 'badge-green' : 'badge-gray'}>{u.role}</span>
              </td>
              <td class="text-xs text-gray-500">{new Date(u.createdAt).toLocaleDateString('id-ID')}</td>
              <td class="text-right">
                <div class="flex items-center justify-end gap-2">
                  <button 
                    class="edit-user-btn p-1.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                    data-id={u.id}
                    data-name={u.name}
                    data-email={u.email}
                    data-phone={u.phone || ''}
                    data-role={u.role}
                    title="Edit"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                  </button>
                  {currentUser?.id !== u.id && (
                    <button 
                      class="delete-user-btn p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                      data-id={u.id}
                      title="Hapus"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Form -->
  <div id="user-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-xl">
      <h3 id="modal-title" class="font-bold text-gray-900 text-lg mb-4">Tambah Pengguna</h3>
      <form id="user-form" class="space-y-4">
        <input type="hidden" id="user-id" name="id" />
        
        <div>
          <label class="label">Nama Lengkap *</label>
          <input type="text" id="user-name" name="name" required class="input-field text-sm" />
        </div>
        
        <div>
          <label class="label">Email *</label>
          <input type="email" id="user-email" name="email" required class="input-field text-sm" />
        </div>
        
        <div>
          <label class="label">No. Telepon</label>
          <input type="tel" id="user-phone" name="phone" class="input-field text-sm" />
        </div>

        <div>
          <label class="label">Role *</label>
          <select id="user-role" name="role" required class="input-field text-sm">
            {availableRoles.map(r => (
              <option value={r.name}>{r.name.charAt(0).toUpperCase() + r.name.slice(1)}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="label" id="password-label">Password *</label>
          <input type="password" id="user-password" name="password" class="input-field text-sm" />
          <p id="password-hint" class="hidden text-xs text-gray-500 mt-1">Kosongkan jika tidak ingin mengubah password.</p>
        </div>
        
        <div class="flex gap-3 pt-4">
          <button type="submit" class="btn-primary flex-1 text-sm">Simpan</button>
          <button type="button" id="close-user-modal" class="btn-ghost flex-1 text-sm">Batal</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const modal = document.getElementById('user-modal');
  const form = document.getElementById('user-form') as HTMLFormElement;
  const modalTitle = document.getElementById('modal-title');
  const pwdLabel = document.getElementById('password-label');
  const pwdInput = document.getElementById('user-password') as HTMLInputElement;
  const pwdHint = document.getElementById('password-hint');

  const openModal = (isEdit = false, data: any = {}) => {
    form.reset();
    if (modalTitle) modalTitle.textContent = isEdit ? 'Edit Pengguna' : 'Tambah Pengguna';
    
    if (isEdit) {
      (document.getElementById('user-id') as HTMLInputElement).value = data.id || '';
      (document.getElementById('user-name') as HTMLInputElement).value = data.name || '';
      (document.getElementById('user-email') as HTMLInputElement).value = data.email || '';
      (document.getElementById('user-phone') as HTMLInputElement).value = data.phone || '';
      (document.getElementById('user-role') as HTMLSelectElement).value = data.role || 'customer';
      
      if (pwdLabel) pwdLabel.textContent = 'Password Baru (Opsional)';
      pwdInput.required = false;
      pwdHint?.classList.remove('hidden');
    } else {
      (document.getElementById('user-id') as HTMLInputElement).value = '';
      if (pwdLabel) pwdLabel.textContent = 'Password *';
      pwdInput.required = true;
      pwdHint?.classList.add('hidden');
    }
    
    modal?.classList.remove('hidden');
  };

  document.getElementById('add-user-btn')?.addEventListener('click', () => openModal(false));
  document.getElementById('close-user-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));

  document.querySelectorAll('.edit-user-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openModal(true, (btn as HTMLElement).dataset);
    });
  });

  document.querySelectorAll('.delete-user-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Apakah Anda yakin ingin menghapus pengguna ini? Tindakan ini tidak dapat dibatalkan.')) return;
      
      const id = (btn as HTMLElement).dataset.id;
      try {
        const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
        const data = await res.json();
        
        if (res.ok) {
          location.reload();
        } else {
          alert(data.error || 'Gagal menghapus pengguna');
        }
      } catch (err) {
        alert('Terjadi kesalahan');
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const id = data.id as string;
    
    // Remove empty id
    if (!id) delete data.id;
    
    // Remove password if empty (on edit)
    if (id && !data.password) {
      delete data.password;
    }

    try {
      const res = await fetch(id ? `/api/users/${id}` : '/api/users', {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      const result = await res.json();
      
      if (res.ok) {
        location.reload();
      } else {
        alert(result.error || 'Gagal menyimpan data');
      }
    } catch (err) {
      alert('Terjadi kesalahan pada server');
    }
  });
</script>
