---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';

const statusFilter = Astro.url.searchParams.get('status') || '';
const search = Astro.url.searchParams.get('search') || '';
const startDate = Astro.url.searchParams.get('startDate') || '';
const endDate = Astro.url.searchParams.get('endDate') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1');
const limit = 20;

const where: any = {};
if (statusFilter) where.status = statusFilter;
if (search) where.OR = [
  { customerName: { contains: search, mode: 'insensitive' } },
  { customerEmail: { contains: search, mode: 'insensitive' } },
  { id: { contains: search } },
];
if (startDate || endDate) {
  where.date = {};
  if (startDate) where.date.gte = new Date(startDate);
  if (endDate) {
    const end = new Date(endDate);
    end.setHours(23, 59, 59, 999);
    where.date.lte = end;
  }
}

const [orders, total] = await Promise.all([
  prisma.order.findMany({ where, orderBy: { date: 'desc' }, skip: (page - 1) * limit, take: limit }),
  prisma.order.count({ where }),
]);
const totalPages = Math.ceil(total / limit);

const statusColor: Record<string, string> = {
  pending: 'badge-yellow', processing: 'badge-blue',
  shipped: 'badge-blue', delivered: 'badge-green', cancelled: 'badge-red',
};
const statuses = ['', 'pending', 'processing', 'shipped', 'delivered', 'cancelled'];
---
<AdminLayout title="Pesanan" currentPage="orders">
  <!-- Filters -->
  <div class="card p-4 mb-5">
    <form method="GET" class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="label text-xs">Cari</label>
        <input name="search" value={search} type="text" class="input-field text-sm py-2" placeholder="ID Pesanan / Nama / Email..." />
      </div>
      <div>
        <label class="label text-xs">Status</label>
        <select name="status" class="input-field text-sm py-2">
          {statuses.map(s => <option value={s} selected={statusFilter === s}>{s || 'Semua Status'}</option>)}
        </select>
      </div>
      <div>
        <label class="label text-xs">Tanggal Mulai</label>
        <input name="startDate" value={startDate} type="date" class="input-field text-sm py-2" />
      </div>
      <div>
        <label class="label text-xs">Tanggal Akhir</label>
        <input name="endDate" value={endDate} type="date" class="input-field text-sm py-2" />
      </div>
      <button type="submit" class="btn-primary text-sm py-2">Filter</button>
      {(search || statusFilter || startDate || endDate) && <a href="/admin/orders" class="btn-ghost text-sm py-2">Reset</a>}
    </form>
  </div>

  <!-- Table -->
  <div class="card">
    <div class="flex items-center justify-between p-5 border-b border-gray-50">
      <h2 class="font-bold text-gray-900">Daftar Pesanan <span class="badge-gray ml-2">{total}</span></h2>
    </div>
    <div class="table-wrapper">
      <table class="data-table">
        <thead><tr>
          <th>ID</th><th>Pelanggan</th><th>Items</th><th>Total</th><th>Pembayaran</th><th>Status</th><th>Tanggal</th><th>Aksi</th>
        </tr></thead>
        <tbody>
          {orders.map(order => {
            const items = Array.isArray(order.items) ? order.items : [];
            return (
              <tr>
                <td><span class="font-mono text-xs text-gray-500">{order.id.slice(-8)}</span></td>
                <td>
                  <p class="font-medium text-gray-900 text-sm">{order.customerName}</p>
                  <p class="text-xs text-gray-500">{order.customerEmail}</p>
                </td>
                <td class="text-sm">{items.length} item</td>
                <td class="font-semibold text-sm">Rp {Number(order.total).toLocaleString('id')}</td>
                <td class="text-sm text-gray-600">{order.paymentMethod || '-'}</td>
                <td><span class={`badge ${statusColor[order.status] || 'badge-gray'} capitalize`}>{order.status}</span></td>
                <td class="text-xs text-gray-500">{new Date(order.date).toLocaleDateString('id-ID')}</td>
                <td>
                  <a href={`/admin/orders/${order.id}`} class="text-blue-600 hover:underline text-sm font-medium">Detail</a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {totalPages > 1 && (
      <div class="flex justify-center gap-2 p-4 border-t border-gray-50">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => {
          const params = new URLSearchParams();
          if (search) params.set('search', search);
          if (statusFilter) params.set('status', statusFilter);
          if (startDate) params.set('startDate', startDate);
          if (endDate) params.set('endDate', endDate);
          params.set('page', String(p));
          return <a href={`/admin/orders?${params}`} class={`w-8 h-8 rounded-lg flex items-center justify-center text-xs font-medium ${p === page ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>{p}</a>;
        })}
      </div>
    )}
  </div>
</AdminLayout>
