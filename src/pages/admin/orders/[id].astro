---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';
import { checkPermission } from '../../../lib/auth';

const canUpdate = await checkPermission(Astro.cookies, 'orders', 'update');

const { id } = Astro.params;
const order = await prisma.order.findUnique({ where: { id } });
if (!order) return Astro.redirect('/admin/orders');

const accounts = await prisma.account.findMany({ orderBy: { name: 'asc' } });
const paymentMethods = await prisma.paymentMethod.findMany();
const pmMap = Object.fromEntries(paymentMethods.map(pm => [pm.name, pm]));
const orderWithPm = { ...order, paymentMethodDetails: pmMap[order.paymentMethod || ''] };

const items = Array.isArray(order.items) ? order.items : [];
const addr = order.shippingAddress as any;

const statusOptions = ['pending','processing','shipped','delivered','cancelled'];
const statusColor: Record<string, string> = {
  pending: 'badge-yellow', processing: 'badge-blue',
  shipped: 'badge-blue', delivered: 'badge-green', cancelled: 'badge-red',
};
---
<AdminLayout title={`Pesanan #${id?.slice(-8)}`} currentPage="orders">
  <div class="mb-5 flex items-center justify-between">
    <a href="/admin/orders" class="text-sm text-blue-600 hover:underline flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Kembali ke Pesanan
    </a>
    <button id="download-invoice-btn" class="btn-ghost text-sm gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      Download Invoice
    </button>
  </div>

  <div id="order-data" data-order={JSON.stringify(orderWithPm)} class="hidden"></div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <div class="xl:col-span-2 space-y-5">
      <!-- Items -->
      <div class="card p-5">
        <h2 class="font-bold text-gray-900 mb-4">Item Pesanan</h2>
        <div class="space-y-3">
          {items.map((item: any) => (
            <div class="flex items-center gap-4 p-3 bg-gray-50 rounded-xl">
              {item.image && <img src={item.image} alt={item.name} class="w-14 h-14 rounded-lg object-cover" />}
              <div class="flex-1">
                <p class="font-semibold text-gray-900 text-sm">{item.name}</p>
                <p class="text-xs text-gray-500 mt-0.5">Qty: {item.qty} {item.dimension ? `× ${item.dimension} ${item.pricingUnit || ''}` : ''}</p>
                {item.options && Object.keys(item.options).length > 0 && (
                  <div class="mt-1.5 flex flex-wrap gap-1.5">
                    {Object.entries(item.options).map(([type, opt]: any) => (
                      <span class="text-xs bg-white text-gray-600 px-2 py-0.5 rounded-md border border-gray-200">
                        <span class="capitalize font-medium">{type}</span>: {opt.name}
                      </span>
                    ))}
                  </div>
                )}
                {item.designUrl && (
                  <a href={item.designUrl} target="_blank" class="inline-flex items-center gap-1 text-xs text-blue-600 font-medium hover:underline mt-2">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    Download File Desain
                  </a>
                )}
                {item.notes && (
                  <p class="text-xs text-amber-700 bg-amber-50 rounded-lg px-3 py-1.5 mt-2 border border-amber-100">
                    📝 <span class="font-medium">Catatan:</span> {item.notes}
                  </p>
                )}
              </div>
              <p class="font-bold text-gray-900 text-sm">Rp {Number(item.price).toLocaleString('id')}</p>
            </div>
          ))}
        </div>
        <div class="border-t border-gray-100 mt-4 pt-4 space-y-2 text-sm">
          <div class="flex justify-between text-gray-600"><span>Subtotal</span><span>Rp {Number(order.subtotal).toLocaleString('id')}</span></div>
          {Number(order.discount) > 0 && <div class="flex justify-between text-green-600"><span>Diskon {order.couponCode && `(${order.couponCode})`}</span><span>-Rp {Number(order.discount).toLocaleString('id')}</span></div>}
          {Number(order.shippingFee) > 0 && <div class="flex justify-between text-gray-600"><span>Ongkir ({order.shippingMethod})</span><span>Rp {Number(order.shippingFee).toLocaleString('id')}</span></div>}
          <div class="flex justify-between font-bold text-gray-900 text-base pt-2 border-t border-gray-100"><span>Total</span><span>Rp {Number(order.total).toLocaleString('id')}</span></div>
        </div>
      </div>

      <!-- Payment Proof -->
      {order.paymentProofUrl && (
        <div class="card p-5">
          <h2 class="font-bold text-gray-900 mb-3">Bukti Pembayaran</h2>
          <img src={order.paymentProofUrl} alt="Bukti Pembayaran" class="rounded-xl max-h-64 object-contain border border-gray-100" />
        </div>
      )}
    </div>

    <!-- Right Column -->
    <div class="space-y-5">
      {canUpdate && (
        <>
          <!-- Shipping Fee Update -->
          {order.shippingMethod === 'Dikirim Kurir' && (
            <div class="card p-5 border-blue-200 bg-blue-50/30">
              <h2 class="font-bold text-gray-900 mb-4">Biaya Pengiriman (Ongkir)</h2>
              <div class="flex items-end gap-2">
                <div class="flex-1">
                  <label class="label text-xs">Total Ongkir (Rp)</label>
                  <input type="number" id="shipping-fee-input" value={Number(order.shippingFee) || ''} placeholder="0" class="input-field text-sm py-1.5 bg-white" />
                </div>
                <button id="update-shipping-btn" class="btn-primary text-sm shrink-0 px-4 py-1.5 h-[38px]">Simpan</button>
              </div>
            </div>
          )}

          <!-- Status Update -->
      <div class="card p-5">
        <h2 class="font-bold text-gray-900 mb-4">Update Status</h2>
        <div class="mb-3">
          <span class={`badge ${statusColor[order.status] || 'badge-gray'} capitalize text-sm`}>{order.status}</span>
        </div>
        
        {order.status === 'pending' && (
          <div class="mb-4 space-y-3 p-3 bg-blue-50 rounded-xl border border-blue-100">
            <p class="text-xs text-blue-800 font-medium">Lengkapi data berikut untuk memproses pesanan:</p>
            {!order.paymentProofUrl && (
              <div>
                <label class="label text-xs">Upload Bukti Pembayaran</label>
                <input type="file" id="payment-proof-file" accept="image/*" class="input-field text-sm py-1.5 bg-white" />
              </div>
            )}
            <div>
              <label class="label text-xs">Masuk ke Rekening (Pemasukan)</label>
              <select id="payment-account-select" class="input-field text-sm bg-white">
                <option value="">-- Pilih Rekening --</option>
                {accounts.map(a => <option value={a.id}>{a.name}</option>)}
              </select>
            </div>
          </div>
        )}

        <div id="status-msg" class="hidden mb-3 text-sm p-2 rounded-lg"></div>
        <select id="status-select" class="input-field mb-3">
            {statusOptions.map(s => <option value={s} selected={order.status === s}>{s}</option>)}
          </select>
          <button id="update-status-btn" class="btn-primary w-full text-sm">Update Status</button>
        </div>
        </>
      )}

      <!-- Customer Info -->
      <div class="card p-5">
        <h2 class="font-bold text-gray-900 mb-4">Info Pelanggan</h2>
        <div class="space-y-2 text-sm">
          <div><span class="text-gray-500">Nama:</span> <span class="font-medium">{order.customerName}</span></div>
          <div><span class="text-gray-500">Email:</span> <span class="font-medium">{order.customerEmail}</span></div>
          {order.customerPhone && <div><span class="text-gray-500">Telepon:</span> <span class="font-medium">{order.customerPhone}</span></div>}
          {order.paymentMethod && <div><span class="text-gray-500">Pembayaran:</span> <span class="font-medium">{order.paymentMethod}</span></div>}
        </div>
      </div>

      <!-- Shipping -->
      {addr && (
        <div class="card p-5">
          <h2 class="font-bold text-gray-900 mb-4">Alamat Pengiriman</h2>
          <div class="text-sm text-gray-700 leading-relaxed">
            <p class="font-medium">{addr.name}</p>
            <p>{addr.address}</p>
            <p>{addr.city}, {addr.province} {addr.postalCode}</p>
            <p>{addr.phone}</p>
          </div>
        </div>
      )}
    </div>
  </div>
</AdminLayout>

<script>
  import { generateInvoice, loadInvoiceLogo } from '../../../lib/invoice';

  const orderId = window.location.pathname.split('/').filter(Boolean).pop();

  // Download Invoice logic
  document.getElementById('download-invoice-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const orderDataElement = document.getElementById('order-data');
    if (!orderDataElement) return;

    btn.disabled = true;
    btn.textContent = 'Memuat...';
    try {
      const orderData = JSON.parse(orderDataElement.dataset.order || '{}');
      const logo = await loadInvoiceLogo();
      generateInvoice(orderData, logo);
    } catch (err) {
      console.error(err);
      alert('Gagal membuat invoice');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Download Invoice';
    }
  });

  document.getElementById('update-status-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Memproses...';
    }

    const statusSelect = document.getElementById('status-select') as HTMLSelectElement;
    const status = statusSelect ? statusSelect.value : '';
    const msg = document.getElementById('status-msg') as HTMLElement;
    
    try {
      let paymentProofUrl = undefined;
      const fileInput = document.getElementById('payment-proof-file') as HTMLInputElement;
      if (fileInput && fileInput.files && fileInput.files.length > 0) {
        const fd = new FormData();
        fd.append('file', fileInput.files[0]);
        const uploadRes = await fetch('/api/upload', { method: 'POST', body: fd });
        if (!uploadRes.ok) throw new Error('Gagal mengunggah bukti pembayaran');
        const uploadData = await uploadRes.json();
        paymentProofUrl = uploadData.url;
      }

      const paymentAccountSelect = document.getElementById('payment-account-select') as HTMLSelectElement;
      const paymentAccountId = paymentAccountSelect ? paymentAccountSelect.value : undefined;

      const res = await fetch(`/api/orders/${orderId}`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status, paymentProofUrl, paymentAccountId }),
      });
      
      const resData = await res.json();

      if (res.ok) {
        if (msg) {
          msg.textContent = 'Status berhasil diupdate!';
          msg.className = 'mb-3 text-sm p-2 rounded-lg bg-green-50 text-green-700';
          msg.classList.remove('hidden');
        }
        setTimeout(() => location.reload(), 1000);
      } else {
        if (msg) {
          msg.textContent = resData.error || 'Gagal mengupdate status.';
          msg.className = 'mb-3 text-sm p-2 rounded-lg bg-red-50 text-red-700';
          msg.classList.remove('hidden');
        }
      }
    } catch (error: any) {
      if (msg) {
        msg.textContent = error.message || 'Error jaringan'; 
        msg.className = 'mb-3 text-sm p-2 rounded-lg bg-red-50 text-red-700';
        msg.classList.remove('hidden'); 
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Update Status';
      }
    }
  });

  document.getElementById('update-shipping-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Memproses...';
    try {
      const shippingFee = (document.getElementById('shipping-fee-input') as HTMLInputElement).value;
      const res = await fetch(`/api/orders/${orderId}`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ shippingFee: Number(shippingFee) }),
      });
      if (res.ok) {
        location.reload();
      } else {
        alert('Gagal menyimpan biaya ongkir');
      }
    } catch (error: any) {
      alert(error.message || 'Error jaringan');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Simpan';
    }
  });
</script>
