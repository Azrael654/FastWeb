---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';
import { checkPermission } from '../../../lib/auth';

const canCreate = await checkPermission(Astro.cookies, 'orders', 'add');
if (!canCreate) return Astro.redirect('/admin/orders');

const paymentMethods = await prisma.paymentMethod.findMany({
  where: { isActive: true },
  orderBy: { name: 'asc' }
});

let error = '';
let successUrl = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const customerName = formData.get('customerName') as string;
    const customerEmail = formData.get('customerEmail') as string;
    const customerPhone = formData.get('customerPhone') as string;
    const paymentMethod = formData.get('paymentMethod') as string;
    const notes = formData.get('notes') as string;
    const shippingMethod = formData.get('shippingMethod') as string;
    const shippingFee = parseFloat(formData.get('shippingFee') as string) || 0;
    const isLunas = formData.get('isLunas') === 'on';
    
    // Parse Items (Dynamic inputs: item_name_X, item_qty_X, item_price_X, item_desc_X)
    const items: any[] = [];
    let subtotal = 0;
    
    // Extract keys
    const keys = Array.from(formData.keys());
    const itemIndices = new Set(
      keys.filter(k => k.startsWith('item_name_')).map(k => k.split('_')[2])
    );
    
    for (const idx of itemIndices) {
      const name = formData.get(`item_name_${idx}`) as string;
      const qty = parseInt(formData.get(`item_qty_${idx}`) as string) || 1;
      const price = parseFloat(formData.get(`item_price_${idx}`) as string) || 0;
      const desc = formData.get(`item_desc_${idx}`) as string;
      
      if (name) {
        items.push({
          productId: 'custom',
          name: name,
          qty: qty,
          price: price,
          dimension: 1,
          options: desc ? { 'Deskripsi': { name: desc, priceAdj: 0 } } : {}
        });
        subtotal += (price * qty);
      }
    }
    
    if (items.length === 0) throw new Error('Tambahkan minimal 1 item.');
    
    const total = subtotal + shippingFee;
    
    const order = await prisma.order.create({
      data: {
        customerName,
        customerEmail,
        customerPhone,
        items,
        subtotal,
        total,
        discount: 0,
        shippingMethod: shippingMethod || null,
        shippingFee,
        shippingAddress: {},
        paymentMethod: paymentMethod || null,
        status: isLunas ? 'processing' : 'pending',
        notes: notes || null
      }
    });
    
    return Astro.redirect(`/admin/orders/${order.id}`);
  } catch (err: any) {
    error = err.message || 'Gagal membuat pesanan manual.';
  }
}
---
<AdminLayout title="Buat Pesanan Manual" currentPage="orders">
  <div class="mb-5 flex items-center justify-between">
    <a href="/admin/orders" class="text-sm text-blue-600 hover:underline flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Kembali ke Pesanan
    </a>
  </div>

  <div class="max-w-4xl">
    <form method="POST" class="space-y-6">
      {error && <div class="p-4 bg-red-50 text-red-700 rounded-xl text-sm">{error}</div>}

      <div class="card p-5">
        <h2 class="font-bold text-gray-900 mb-4 border-b pb-3">Data Pelanggan</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="label">Nama Pelanggan *</label>
            <input type="text" name="customerName" required class="input-field" placeholder="Nama..." />
          </div>
          <div>
            <label class="label">No. Telepon / WA *</label>
            <input type="text" name="customerPhone" required class="input-field" placeholder="0812..." />
          </div>
          <div class="sm:col-span-2">
            <label class="label">Email (Opsional)</label>
            <input type="email" name="customerEmail" class="input-field" placeholder="email@contoh.com" />
            <p class="text-xs text-gray-500 mt-1">Isi email agar pelanggan bisa melihat riwayat pesanan ini di dasbor mereka (jika mendaftar dengan email yang sama).</p>
          </div>
        </div>
      </div>

      <div class="card p-5">
        <div class="flex items-center justify-between border-b pb-3 mb-4">
          <h2 class="font-bold text-gray-900">Item Pesanan</h2>
          <button type="button" id="add-item-btn" class="btn-primary text-xs py-1.5 px-3">+ Tambah Item</button>
        </div>
        
        <div id="items-container" class="space-y-4">
          <!-- Item 1 -->
          <div class="item-row grid grid-cols-12 gap-3 items-start bg-gray-50 p-3 rounded-xl border border-gray-100">
            <div class="col-span-12 sm:col-span-5">
              <label class="text-xs font-semibold text-gray-700 block mb-1">Nama Produk / Custom *</label>
              <input type="text" name="item_name_0" required class="input-field text-sm" placeholder="Contoh: Plakat Akrilik 20cm" />
              <input type="text" name="item_desc_0" class="input-field text-xs mt-2" placeholder="Spesifikasi tambahan / opsi (opsional)" />
            </div>
            <div class="col-span-6 sm:col-span-2">
              <label class="text-xs font-semibold text-gray-700 block mb-1">Qty *</label>
              <input type="number" name="item_qty_0" min="1" required value="1" class="input-field text-sm item-qty" />
            </div>
            <div class="col-span-6 sm:col-span-4">
              <label class="text-xs font-semibold text-gray-700 block mb-1">Harga Satuan (Rp) *</label>
              <input type="number" name="item_price_0" min="0" required value="0" class="input-field text-sm item-price" />
            </div>
            <div class="col-span-12 sm:col-span-1 flex justify-end sm:mt-6">
              <!-- No delete for the first item initially to keep things simple -->
            </div>
          </div>
        </div>
        
        <div class="mt-4 text-right">
           <p class="text-gray-600 text-sm">Subtotal: <span id="subtotal-display" class="font-bold text-gray-900 text-lg">Rp 0</span></p>
        </div>
      </div>

      <div class="card p-5">
        <h2 class="font-bold text-gray-900 mb-4 border-b pb-3">Pengiriman & Pembayaran</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="label">Metode Pengiriman</label>
            <input type="text" name="shippingMethod" class="input-field" placeholder="Diambil / Kurir Mandiri..." />
          </div>
          <div>
            <label class="label">Ongkos Kirim (Rp)</label>
            <input type="number" name="shippingFee" id="shipping-fee" value="0" min="0" class="input-field" />
          </div>
          <div>
            <label class="label">Metode Pembayaran</label>
            <select name="paymentMethod" class="input-field">
              <option value="">Pilih Metode Pembayaran...</option>
              {paymentMethods.map(pm => <option value={pm.name}>{pm.name}</option>)}
            </select>
          </div>
          <div class="flex items-center gap-2 pt-6">
            <input type="checkbox" name="isLunas" id="isLunas" class="w-5 h-5 text-blue-600 rounded" />
            <label for="isLunas" class="font-medium text-gray-700 cursor-pointer">Tandai Langsung Lunas (Status: Processing)</label>
          </div>
        </div>
        
        <div class="mt-4">
          <label class="label">Catatan Admin</label>
          <textarea name="notes" rows="2" class="input-field" placeholder="Catatan internal pesanan ini..."></textarea>
        </div>
      </div>
      
      <div class="card p-5 bg-blue-50 border-blue-100 flex items-center justify-between">
        <div>
           <p class="text-sm text-blue-800">Total Akhir</p>
           <p id="total-display" class="text-2xl font-bold text-blue-900">Rp 0</p>
        </div>
        <button type="submit" class="btn-primary py-3 px-6 text-lg shadow-lg shadow-blue-500/30">Buat Pesanan</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  let itemCounter = 1;
  const container = document.getElementById('items-container');
  const addBtn = document.getElementById('add-item-btn');
  const subtotalDisplay = document.getElementById('subtotal-display');
  const totalDisplay = document.getElementById('total-display');
  const shippingInput = document.getElementById('shipping-fee') as HTMLInputElement;

  function calculateTotal() {
    let subtotal = 0;
    document.querySelectorAll('.item-row').forEach(row => {
      const qty = parseInt((row.querySelector('.item-qty') as HTMLInputElement).value) || 0;
      const price = parseFloat((row.querySelector('.item-price') as HTMLInputElement).value) || 0;
      subtotal += (qty * price);
    });
    
    const shipping = parseFloat(shippingInput?.value) || 0;
    const total = subtotal + shipping;
    
    if (subtotalDisplay) subtotalDisplay.textContent = 'Rp ' + subtotal.toLocaleString('id');
    if (totalDisplay) totalDisplay.textContent = 'Rp ' + total.toLocaleString('id');
  }

  addBtn?.addEventListener('click', () => {
    const idx = itemCounter++;
    const row = document.createElement('div');
    row.className = 'item-row grid grid-cols-12 gap-3 items-start bg-gray-50 p-3 rounded-xl border border-gray-100 mt-3';
    row.innerHTML = `
      <div class="col-span-12 sm:col-span-5">
        <label class="text-xs font-semibold text-gray-700 block mb-1">Nama Produk / Custom *</label>
        <input type="text" name="item_name_${idx}" required class="input-field text-sm" placeholder="Contoh: Banner 3x2" />
        <input type="text" name="item_desc_${idx}" class="input-field text-xs mt-2" placeholder="Spesifikasi tambahan / opsi (opsional)" />
      </div>
      <div class="col-span-6 sm:col-span-2">
        <label class="text-xs font-semibold text-gray-700 block mb-1">Qty *</label>
        <input type="number" name="item_qty_${idx}" min="1" required value="1" class="input-field text-sm item-qty" />
      </div>
      <div class="col-span-6 sm:col-span-4">
        <label class="text-xs font-semibold text-gray-700 block mb-1">Harga Satuan (Rp) *</label>
        <input type="number" name="item_price_${idx}" min="0" required value="0" class="input-field text-sm item-price" />
      </div>
      <div class="col-span-12 sm:col-span-1 flex justify-end sm:mt-6">
        <button type="button" class="text-red-500 hover:text-red-700 p-1 remove-btn" title="Hapus">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </div>
    `;
    container?.appendChild(row);
    
    row.querySelector('.remove-btn')?.addEventListener('click', () => {
      row.remove();
      calculateTotal();
    });
    
    row.querySelectorAll('input[type="number"]').forEach(input => {
      input.addEventListener('input', calculateTotal);
    });
  });

  // Attach event listeners to initial inputs
  document.querySelectorAll('.item-qty, .item-price, #shipping-fee').forEach(input => {
    input.addEventListener('input', calculateTotal);
  });
</script>
