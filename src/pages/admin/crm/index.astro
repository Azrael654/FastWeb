---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';

const search = Astro.url.searchParams.get('search') || '';
const type = Astro.url.searchParams.get('type') || '';

const where: any = {};
const andConditions: any[] = [];

if (search) {
  andConditions.push({
    OR: [
      { name: { contains: search, mode: 'insensitive' } },
      { email: { contains: search, mode: 'insensitive' } },
      { company: { contains: search, mode: 'insensitive' } }
    ]
  });
}
if (type) {
  andConditions.push({ type });
}

if (andConditions.length > 0) {
  where.AND = andConditions;
}

const contacts = await prisma.contact.findMany({ where, orderBy: { dateAdded: 'desc' } });
const typeColor: Record<string,string> = { lead: 'badge-yellow', client: 'badge-green', vendor: 'badge-blue' };
---
<AdminLayout title="CRM – Kontak" currentPage="crm">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Kontak</h2>
      <p class="text-sm text-gray-500">{contacts.length} kontak tersimpan</p>
    </div>
    <button id="add-contact-btn" class="btn-primary text-sm">+ Tambah Kontak</button>
  </div>

  <form class="flex flex-col sm:flex-row gap-3 mb-5" action="/admin/crm" method="GET">
    <input type="text" name="search" value={search} placeholder="Cari nama, email, perusahaan..." class="input-field text-sm flex-1" />
    <select name="type" class="input-field text-sm w-full sm:w-48">
      <option value="">Semua Tipe</option>
      <option value="lead" selected={type === 'lead'}>Lead</option>
      <option value="client" selected={type === 'client'}>Client</option>
      <option value="vendor" selected={type === 'vendor'}>Vendor</option>
    </select>
    <button type="submit" class="btn-primary text-sm px-4">Filter</button>
    { (search || type) && <a href="/admin/crm" class="btn-ghost text-sm px-4 flex items-center justify-center">Reset</a> }
  </form>

  <div class="card">
    <div class="table-wrapper">
      <table class="data-table">
        <thead><tr><th>Nama</th><th>Email</th><th>Telepon</th><th>Perusahaan</th><th>Tipe</th><th>Pesan</th><th>Tanggal</th><th>Aksi</th></tr></thead>
        <tbody>
          {contacts.map(c => (
            <tr>
              <td class="font-medium text-sm text-gray-900">{c.name}</td>
              <td class="text-sm text-gray-600">{c.email || '-'}</td>
              <td class="text-sm text-gray-600">{c.phone || '-'}</td>
              <td class="text-sm text-gray-600">{c.company || '-'}</td>
              <td><span class={`badge ${typeColor[c.type] || 'badge-gray'} capitalize text-xs`}>{c.type}</span></td>
              <td class="text-sm text-gray-600 max-w-[200px]">
                {c.notes ? (
                  <button
                    class="view-notes-btn text-blue-600 hover:underline text-xs text-left line-clamp-2"
                    data-name={c.name}
                    data-notes={c.notes}
                  >
                    {c.notes.length > 60 ? c.notes.slice(0, 60) + '…' : c.notes}
                  </button>
                ) : <span class="text-gray-400">-</span>}
              </td>
              <td class="text-xs text-gray-500">{new Date(c.dateAdded).toLocaleDateString('id-ID')}</td>
              <td>
                <div class="flex gap-2">
                  <button
                    data-contact={JSON.stringify(c)}
                    class="edit-contact text-blue-500 hover:underline text-xs"
                  >Edit</button>
                  <button
                    data-id={c.id}
                    class="delete-contact text-red-500 hover:underline text-xs"
                  >Hapus</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add/Edit Contact Modal -->
  <div id="contact-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-xl">
      <h3 id="modal-title" class="font-bold text-gray-900 text-lg mb-4">Tambah Kontak</h3>
      <form id="contact-form" class="space-y-3">
        <input type="hidden" name="id" id="contact-id" />
        <div><label class="label">Nama *</label><input name="name" required class="input-field text-sm" /></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="label">Email</label><input name="email" type="email" class="input-field text-sm" /></div>
          <div><label class="label">Telepon</label><input name="phone" class="input-field text-sm" /></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="label">Perusahaan</label><input name="company" class="input-field text-sm" /></div>
          <div><label class="label">Tipe</label>
            <select name="type" class="input-field text-sm">
              <option value="lead">Lead</option>
              <option value="client">Client</option>
              <option value="vendor">Vendor</option>
            </select>
          </div>
        </div>
        <div><label class="label">Catatan / Pesan</label><textarea name="notes" class="input-field text-sm" rows="3"></textarea></div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="btn-primary flex-1 text-sm">Simpan</button>
          <button type="button" id="close-contact-modal" class="btn-ghost flex-1 text-sm">Batal</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Notes Detail Modal -->
  <div id="notes-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-lg shadow-xl">
      <div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3">
        <h3 id="notes-modal-name" class="font-bold text-gray-900 text-lg"></h3>
        <button id="close-notes-modal" class="text-gray-400 hover:text-gray-600 text-xl leading-none">&times;</button>
      </div>
      <p class="text-sm text-gray-500 mb-2">Pesan:</p>
      <div id="notes-modal-content" class="bg-gray-50 rounded-xl p-4 text-sm text-gray-800 whitespace-pre-wrap leading-relaxed max-h-72 overflow-y-auto"></div>
    </div>
  </div>
</AdminLayout>

<script>
  const modalTitle = document.getElementById('modal-title')!;
  const contactIdInput = document.getElementById('contact-id') as HTMLInputElement;
  const contactForm = document.getElementById('contact-form') as HTMLFormElement;

  // Add contact modal
  document.getElementById('add-contact-btn')?.addEventListener('click', () => {
    modalTitle.textContent = 'Tambah Kontak';
    contactIdInput.value = '';
    contactForm.reset();
    document.getElementById('contact-modal')?.classList.remove('hidden');
  });
  
  document.getElementById('close-contact-modal')?.addEventListener('click', () =>
    document.getElementById('contact-modal')?.classList.add('hidden'));

  // Edit contact modal
  document.querySelectorAll('.edit-contact').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const data = JSON.parse(el.dataset.contact || '{}');
      modalTitle.textContent = 'Edit Kontak';
      contactIdInput.value = data.id || '';
      
      (contactForm.elements.namedItem('name') as HTMLInputElement).value = data.name || '';
      (contactForm.elements.namedItem('email') as HTMLInputElement).value = data.email || '';
      (contactForm.elements.namedItem('phone') as HTMLInputElement).value = data.phone || '';
      (contactForm.elements.namedItem('company') as HTMLInputElement).value = data.company || '';
      (contactForm.elements.namedItem('type') as HTMLSelectElement).value = data.type || 'lead';
      (contactForm.elements.namedItem('notes') as HTMLTextAreaElement).value = data.notes || '';
      
      document.getElementById('contact-modal')?.classList.remove('hidden');
    });
  });

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(e.target as HTMLFormElement));
    const isEdit = !!data.id;
    const url = isEdit ? `/api/crm/contacts/${data.id}` : '/api/crm/contacts';
    const method = isEdit ? 'PUT' : 'POST';

    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    if (res.ok) location.reload(); else alert('Gagal menyimpan');
  });

  // Delete contacts
  document.querySelectorAll('.delete-contact').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      if (!confirm('Hapus kontak ini?')) return;
      const id = (e.currentTarget as HTMLElement).dataset.id;
      const res = await fetch(`/api/crm/contacts/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else alert('Gagal menghapus');
    });
  });

  // View notes modal
  const notesModal = document.getElementById('notes-modal')!;
  document.querySelectorAll('.view-notes-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      document.getElementById('notes-modal-name')!.textContent = el.dataset.name || '';
      document.getElementById('notes-modal-content')!.textContent = el.dataset.notes || '';
      notesModal.classList.remove('hidden');
    });
  });
  document.getElementById('close-notes-modal')?.addEventListener('click', () =>
    notesModal.classList.add('hidden'));
  notesModal.addEventListener('click', (e) => {
    if (e.target === notesModal) notesModal.classList.add('hidden');
  });
</script>
