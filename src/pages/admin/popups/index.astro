---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';

const popups = await prisma.popup.findMany({ orderBy: { createdAt: 'desc' } });
---
<AdminLayout title="Popup Builder" currentPage="popups">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Popup Builder</h2>
      <p class="text-sm text-gray-500">Kelola pop-up promosi atau pengumuman di halaman depan</p>
    </div>
    <button id="add-btn" class="btn-primary text-sm">+ Buat Popup Baru</button>
  </div>

  <div class="card mb-8">
    <div class="table-wrapper">
      <table class="data-table">
        <thead><tr><th>Judul / Preview</th><th>Tampil</th><th>Delay</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody>
          {popups.map(p => (
            <tr>
              <td>
                <div class="flex items-center gap-3">
                  {p.imageUrl && <img src={p.imageUrl} class="w-10 h-10 rounded object-cover" />}
                  <div>
                    <p class="font-medium text-sm text-gray-900">{p.title}</p>
                    {p.linkUrl && <p class="text-xs text-blue-600 hover:underline">{p.linkUrl}</p>}
                  </div>
                </div>
              </td>
              <td class="text-sm text-gray-600 capitalize">{p.displayMode === 'once' ? 'Sekali (Close = Hilang)' : p.displayMode === 'session' ? 'Per Sesi' : 'Selalu Tampil'}</td>
              <td class="text-sm text-gray-600">{p.delaySeconds} dtk</td>
              <td>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" class="sr-only peer toggle-active" data-id={p.id} checked={p.isActive}>
                  <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
                </label>
              </td>
              <td>
                <div class="flex items-center gap-3">
                  <button class="edit-btn text-yellow-600 hover:text-yellow-800 text-xs" data-popup={JSON.stringify(p)}>Edit</button>
                  <button class="delete-btn text-red-500 hover:text-red-700 text-xs" data-id={p.id}>Hapus</button>
                </div>
              </td>
            </tr>
          ))}
          {popups.length === 0 && <tr><td colspan="5" class="text-center py-8 text-gray-400">Belum ada popup</td></tr>}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal -->
  <div id="popup-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-2xl shadow-xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 class="font-bold text-gray-900 text-lg" id="modal-title">Buat Popup Baru</h3>
        <button id="close-modal" class="text-gray-400 hover:text-gray-600">&times;</button>
      </div>
      
      <form id="popup-form" class="space-y-4">
        <input type="hidden" name="id" id="form-id" />
        
        <div>
          <label class="label">Judul (Internal / Heading) *</label>
          <input name="title" id="form-title-input" required class="input-field" placeholder="Promo Lebaran" />
        </div>
        
        <div>
          <label class="label">Gambar Banner</label>
          <div class="flex gap-4 items-end">
            <div class="flex-1">
              <input type="file" id="image-file" accept="image/*" class="input-field py-1.5" />
              <input type="hidden" name="imageUrl" id="image-url" />
            </div>
            <img id="image-preview" src="" class="hidden w-16 h-16 rounded object-cover border border-gray-200" />
          </div>
          <p class="text-xs text-gray-500 mt-1">Gunakan gambar persegi atau proporsional. Jika ada teks promo di gambar, kosongkan Deskripsi Singkat di bawah.</p>
        </div>

        <div>
          <label class="label">Deskripsi Singkat (Opsional)</label>
          <textarea name="content" id="form-content" rows="3" class="input-field text-sm" placeholder="Diskon 50% untuk produk banner..."></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label">Teks Tombol Aksi (Opsional)</label>
            <input name="linkText" id="form-linkText" class="input-field" placeholder="Belanja Sekarang" />
          </div>
          <div>
            <label class="label">URL Tujuan</label>
            <input name="linkUrl" id="form-linkUrl" class="input-field" placeholder="/shop atau https://..." />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label">Mode Tampil</label>
            <select name="displayMode" id="form-displayMode" class="input-field">
              <option value="once">Sekali (Jika di-close tidak muncul lagi)</option>
              <option value="session">Per Sesi (Muncul 1x per kunjungan web)</option>
              <option value="always">Selalu Tampil tiap buka halaman</option>
            </select>
          </div>
          <div>
            <label class="label">Delay Tampil (Detik)</label>
            <input type="number" name="delaySeconds" id="form-delay" class="input-field" value="2" min="0" />
          </div>
        </div>

        <div class="flex items-center gap-2 pt-2 border-t border-gray-100">
          <input type="checkbox" name="isActive" id="form-isActive" value="true" class="w-4 h-4 text-blue-600 rounded" />
          <label for="form-isActive" class="text-sm font-medium text-gray-700">Aktifkan popup ini</label>
        </div>

        <div class="flex gap-3 pt-4">
          <button type="submit" class="btn-primary flex-1">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const modal = document.getElementById('popup-modal')!;
  const form = document.getElementById('popup-form') as HTMLFormElement;
  const idInput = document.getElementById('form-id') as HTMLInputElement;
  const imgUrl = document.getElementById('image-url') as HTMLInputElement;
  const imgPreview = document.getElementById('image-preview') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title')!;

  document.getElementById('add-btn')?.addEventListener('click', () => {
    form.reset();
    idInput.value = '';
    imgUrl.value = '';
    imgPreview.src = '';
    imgPreview.classList.add('hidden');
    modalTitle.textContent = 'Buat Popup Baru';
    modal.classList.remove('hidden');
  });

  document.getElementById('close-modal')?.addEventListener('click', () => {
    modal.classList.add('hidden');
  });

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const data = JSON.parse(el.dataset.popup!);
      
      idInput.value = data.id;
      (document.getElementById('form-title-input') as HTMLInputElement).value = data.title;
      (document.getElementById('form-content') as HTMLInputElement).value = data.content || '';
      (document.getElementById('form-linkText') as HTMLInputElement).value = data.linkText || '';
      (document.getElementById('form-linkUrl') as HTMLInputElement).value = data.linkUrl || '';
      (document.getElementById('form-displayMode') as HTMLSelectElement).value = data.displayMode;
      (document.getElementById('form-delay') as HTMLInputElement).value = data.delaySeconds;
      (document.getElementById('form-isActive') as HTMLInputElement).checked = data.isActive;
      
      imgUrl.value = data.imageUrl || '';
      if (data.imageUrl) {
        imgPreview.src = data.imageUrl;
        imgPreview.classList.remove('hidden');
      } else {
        imgPreview.src = '';
        imgPreview.classList.add('hidden');
      }
      
      modalTitle.textContent = 'Edit Popup';
      modal.classList.remove('hidden');
    });
  });

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      if (!confirm('Yakin ingin menghapus popup ini?')) return;
      const el = e.currentTarget as HTMLElement;
      const res = await fetch(`/api/popups/${el.dataset.id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else alert('Gagal menghapus popup');
    });
  });

  document.querySelectorAll('.toggle-active').forEach(toggle => {
    toggle.addEventListener('change', async (e) => {
      const el = e.currentTarget as HTMLInputElement;
      const res = await fetch(`/api/popups/${el.dataset.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isActive: el.checked })
      });
      if (!res.ok) {
        el.checked = !el.checked;
        alert('Gagal merubah status');
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyimpan...';

    try {
      const fd = new FormData(form);
      const data: any = Object.fromEntries(fd);
      data.isActive = fd.get('isActive') === 'true';

      const fileInput = document.getElementById('image-file') as HTMLInputElement;
      if (fileInput.files && fileInput.files.length > 0) {
        const uploadFd = new FormData();
        uploadFd.append('file', fileInput.files[0]);
        const uploadRes = await fetch('/api/upload', { method: 'POST', body: uploadFd });
        if (uploadRes.ok) {
          const uploadData = await uploadRes.json();
          data.imageUrl = uploadData.url;
        } else {
          throw new Error('Gagal mengunggah gambar');
        }
      }

      const isEdit = !!data.id;
      const url = isEdit ? `/api/popups/${data.id}` : '/api/popups';
      const method = isEdit ? 'PUT' : 'POST';
      
      const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) {
        location.reload();
      } else { 
        const err = await res.json(); 
        throw new Error(err.error || 'Gagal menyimpan popup'); 
      }
    } catch (error: any) {
      alert(error.message || 'Terjadi kesalahan');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Simpan';
    }
  });
</script>
