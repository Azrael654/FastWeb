---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/prisma';

const categories = await prisma.category.findMany({ orderBy: { name: 'asc' } });
---
<AdminLayout title="Kategori" currentPage="categories">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Kategori Produk</h2>
      <p class="text-sm text-gray-500">{categories.length} kategori</p>
    </div>
    <button id="add-cat-btn" class="btn-primary text-sm">+ Tambah Kategori</button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {categories.map(cat => (
      <div class="card p-4 flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center shrink-0">
          {cat.image ? <img src={cat.image} alt={cat.name} class="w-8 h-8 object-contain" /> : <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <p class="font-semibold text-gray-900 text-sm">{cat.name}</p>
            {cat.showInHome && <span class="bg-blue-100 text-blue-700 text-[10px] font-medium px-1.5 py-0.5 rounded">Home</span>}
            {cat.showInFooter && <span class="bg-blue-100 text-blue-700 text-[10px] font-medium px-1.5 py-0.5 rounded">Footer</span>}
          </div>
          <p class="text-xs text-gray-500 font-mono mt-0.5">{cat.slug}</p>
          {cat.description && <p class="text-xs text-gray-400 mt-0.5 line-clamp-1">{cat.description}</p>}
        </div>
        <div class="flex gap-2">
          <button data-id={cat.id} data-name={cat.name} data-slug={cat.slug} data-desc={cat.description || ''} data-img={cat.image || ''} data-showhome={cat.showInHome.toString()} data-showfooter={cat.showInFooter.toString()} class="edit-cat text-blue-400 hover:text-blue-600 transition-colors p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          </button>
          <button data-id={cat.id} class="delete-cat text-red-400 hover:text-red-600 transition-colors p-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- Modal -->
  <div id="cat-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-xl">
      <h3 id="cat-modal-title" class="font-bold text-gray-900 text-lg mb-4">Tambah Kategori</h3>
      <form id="cat-form" class="space-y-3">
        <input type="hidden" name="id" id="cat-id" />
        <div><label class="label">Nama *</label><input name="name" required class="input-field text-sm" id="cat-name" /></div>
        <div><label class="label">Slug</label><input name="slug" id="cat-slug" class="input-field text-sm font-mono" /></div>
        <div><label class="label">Deskripsi</label><textarea name="description" class="input-field text-sm" rows="2"></textarea></div>
        <div>
          <label class="label">Gambar</label>
          <div class="flex flex-col gap-2">
            <input type="file" id="image-file" accept="image/*" class="input-field text-sm py-1.5" />
            <input type="hidden" name="image" id="image-url" />
          </div>
        </div>
        <div class="flex gap-4 pt-1">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="cat-showHome" class="w-4 h-4 text-blue-600 rounded border-gray-300" checked />
            <span class="text-sm text-gray-700">Tampil di Beranda</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="cat-showFooter" class="w-4 h-4 text-blue-600 rounded border-gray-300" checked />
            <span class="text-sm text-gray-700">Tampil di Footer</span>
          </label>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="btn-primary flex-1 text-sm">Simpan</button>
          <button type="button" id="close-cat-modal" class="btn-ghost flex-1 text-sm">Batal</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  document.getElementById('add-cat-btn')?.addEventListener('click', () => {
    (document.getElementById('cat-form') as HTMLFormElement).reset();
    (document.getElementById('cat-id') as HTMLInputElement).value = '';
    (document.getElementById('cat-showHome') as HTMLInputElement).checked = true;
    (document.getElementById('cat-showFooter') as HTMLInputElement).checked = true;
    document.getElementById('cat-modal-title')!.textContent = 'Tambah Kategori';
    document.getElementById('cat-modal')?.classList.remove('hidden');
  });

  document.querySelectorAll('.edit-cat').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      (document.getElementById('cat-id') as HTMLInputElement).value = el.dataset.id!;
      (document.getElementById('cat-name') as HTMLInputElement).value = el.dataset.name!;
      (document.getElementById('cat-slug') as HTMLInputElement).value = el.dataset.slug!;
      (document.querySelector('textarea[name="description"]') as HTMLTextAreaElement).value = el.dataset.desc!;
      (document.getElementById('image-url') as HTMLInputElement).value = el.dataset.img!;
      (document.getElementById('cat-showHome') as HTMLInputElement).checked = el.dataset.showhome === 'true';
      (document.getElementById('cat-showFooter') as HTMLInputElement).checked = el.dataset.showfooter === 'true';
      document.getElementById('cat-modal-title')!.textContent = 'Edit Kategori';
      document.getElementById('cat-modal')?.classList.remove('hidden');
    });
  });

  document.getElementById('close-cat-modal')?.addEventListener('click', () => document.getElementById('cat-modal')?.classList.add('hidden'));
  document.getElementById('cat-name')?.addEventListener('input', (e) => {
    const slug = (e.target as HTMLInputElement).value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    (document.getElementById('cat-slug') as HTMLInputElement).value = slug;
  });
  document.getElementById('cat-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyimpan...';

    try {
      const fd = new FormData(form);
      const data: any = Object.fromEntries(fd);
      data.showInHome = (document.getElementById('cat-showHome') as HTMLInputElement).checked;
      data.showInFooter = (document.getElementById('cat-showFooter') as HTMLInputElement).checked;
      
      
      const fileInput = document.getElementById('image-file') as HTMLInputElement;
      if (fileInput.files && fileInput.files.length > 0) {
        const uploadFd = new FormData();
        uploadFd.append('file', fileInput.files[0]);
        const uploadRes = await fetch('/api/upload', { method: 'POST', body: uploadFd });
        if (uploadRes.ok) {
          const uploadData = await uploadRes.json();
          data.image = uploadData.url;
        } else {
          throw new Error('Gagal mengunggah gambar');
        }
      }

      if (!data.slug) data.slug = data.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      
      const isEdit = !!data.id;
      const url = isEdit ? `/api/categories/${data.id}` : '/api/categories';
      const method = isEdit ? 'PUT' : 'POST';

      const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      if (res.ok) location.reload(); else throw new Error('Gagal menyimpan kategori');
    } catch (error: any) {
      alert(error.message || 'Terjadi kesalahan');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Simpan';
    }
  });
  document.querySelectorAll('.delete-cat').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Hapus kategori? Produk yang terkait mungkin terpengaruh.')) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/categories/${id}`, { method: 'DELETE' });
      if (res.ok) location.reload(); else alert('Gagal menghapus');
    });
  });
</script>
