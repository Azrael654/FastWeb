---
import MainLayout from "../../layouts/MainLayout.astro";
import { requireAuth } from "../../lib/auth";
import prisma from "../../lib/prisma";

const user = requireAuth(Astro.cookies);
if (!user) {
  return Astro.redirect("/login?redirect=/dashboard");
}

const dbUser = await prisma.appUser.findUnique({
  where: { id: user.id },
});

const rawOrders = await prisma.order.findMany({
  where: {
    OR: [{ userId: user.id }, { customerEmail: user.email }],
  },
  orderBy: { createdAt: "desc" },
});

const paymentMethods = await prisma.paymentMethod.findMany();
const pmMap = Object.fromEntries(paymentMethods.map(pm => [pm.name, pm]));
const orders = rawOrders.map(o => ({
  ...o,
  paymentMethodDetails: pmMap[o.paymentMethod || '']
}));

const contactInfo = await prisma.storeConfig.upsert({
  where: { id: "singleton" },
  update: {},
  create: { id: "singleton" },
});

// Format currency
const formatPrice = (price: any) => {
  return Number(price).toLocaleString("id-ID");
};
---

<MainLayout title="Dasbor Pengguna – Fast Print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 font-display">Dasbor Saya</h1>
      <p class="text-gray-500 mt-2">Selamat datang kembali, {dbUser?.name}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      {/* Sidebar */}
      <div class="lg:col-span-1 space-y-6">
        <div class="card p-6 text-center">
          <div
            class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl font-bold text-blue-700"
              >{dbUser?.name.charAt(0).toUpperCase()}</span
            >
          </div>
          <h2 class="font-bold text-gray-900 text-lg">{dbUser?.name}</h2>
          <p class="text-sm text-gray-500 mb-4">{dbUser?.email}</p>

          <form action="/api/auth/logout" method="POST">
            <button
              type="submit"
              class="btn-ghost w-full justify-center text-red-600 hover:bg-red-50 hover:text-red-700"
            >
              <svg
                class="w-4 h-4 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                ></path></svg
              >
              Keluar
            </button>
          </form>
        </div>

        <div class="card p-6">
          <h3 class="font-bold text-gray-900 mb-4">Informasi Kontak</h3>
          <div class="space-y-3 text-sm">
            <div>
              <p class="text-gray-500">No. Telepon</p>
              <p class="font-medium text-gray-900">{dbUser?.phone || "-"}</p>
            </div>
            <div>
              <p class="text-gray-500">Alamat Default</p>
              <p class="font-medium text-gray-900 line-clamp-2">
                {dbUser?.address || "Belum diatur"}
              </p>
            </div>
          </div>
          <button
            id="edit-profile-btn"
            class="btn-ghost w-full mt-4 text-blue-600 hover:text-blue-700 text-sm"
          >
            Edit Profil
          </button>
        </div>
      </div>

      {/* Main Content */}
      <div class="lg:col-span-3">
        <div class="card">
          <div
            class="p-6 border-b border-gray-100 flex items-center justify-between"
          >
            <h2 class="font-bold text-gray-900 text-lg">Riwayat Pesanan</h2>
            <span class="badge-blue">{orders.length} Pesanan</span>
          </div>

          <div class="p-6">
            {
              orders.length === 0 ? (
                <div class="text-center py-10">
                  <svg
                    class="w-16 h-16 text-gray-300 mx-auto mb-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                    />
                  </svg>
                  <p class="text-gray-500 font-medium mb-4">
                    Belum ada pesanan.
                  </p>
                  <a href="/shop" class="btn-primary">
                    Mulai Belanja
                  </a>
                </div>
              ) : (
                <div class="space-y-6">
                  {orders.map((order: any) => (
                    <div class="border border-gray-100 rounded-xl overflow-hidden">
                      <div class="bg-gray-50 px-5 py-3 flex flex-wrap items-center justify-between gap-4 border-b border-gray-100">
                        <div>
                          <p class="text-xs text-gray-500">Tanggal Pesanan</p>
                          <p class="text-sm font-semibold text-gray-900">
                            {new Date(order.createdAt).toLocaleDateString(
                              "id-ID",
                              {
                                day: "numeric",
                                month: "long",
                                year: "numeric",
                              },
                            )}
                          </p>
                        </div>
                        <div>
                          <p class="text-xs text-gray-500">Total Tagihan</p>
                          <p class="text-sm font-bold text-blue-600">
                            Rp {formatPrice(order.total)}
                          </p>
                        </div>
                        <div>
                          <p class="text-xs text-gray-500">Status</p>
                          <span
                            class={`badge mt-0.5 ${
                              order.status === "pending"
                                ? "badge-yellow"
                                : order.status === "processing"
                                  ? "badge-blue"
                                  : order.status === "shipped"
                                    ? "badge-blue"
                                    : order.status === "delivered"
                                      ? "badge-green"
                                      : "badge-gray"
                            }`}
                          >
                            {order.status.toUpperCase()}
                          </span>
                        </div>
                        <div class="text-right flex flex-col items-end">
                          <p class="text-xs text-gray-500">ID Pesanan</p>
                          <p class="text-sm font-mono text-gray-900 mb-1">
                            #{order.id.slice(-6).toUpperCase()}
                          </p>
                          <button
                            data-order={JSON.stringify(order)}
                            class="download-invoice-btn text-xs text-blue-600 hover:underline flex items-center gap-1 font-medium"
                          >
                            <svg
                              class="w-3 h-3"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                              />
                            </svg>
                            Invoice
                          </button>
                        </div>
                      </div>

                      <div class="p-5">
                        <div class="space-y-3">
                          {(Array.isArray(order.items) ? order.items : []).map(
                            (item: any) => (
                              <div class="flex items-center gap-4">
                                <div class="w-16 h-16 bg-gray-100 rounded-lg overflow-hidden shrink-0">
                                  {item.image ? (
                                    <img
                                      src={item.image}
                                      alt={item.name}
                                      class="w-full h-full object-cover"
                                    />
                                  ) : (
                                    <div class="w-full h-full bg-blue-50" />
                                  )}
                                </div>
                                <div class="flex-1 min-w-0">
                                  <p class="text-sm font-semibold text-gray-900">
                                    {item.name}
                                  </p>
                                  <p class="text-xs text-gray-500 mt-0.5">
                                    Qty: {item.qty}{" "}
                                    {item.dimension
                                      ? `(Uk: ${item.dimension})`
                                      : ""}
                                  </p>
                                  {item.notes && (
                                    <p class="text-xs text-amber-700 bg-amber-50 rounded-md px-2 py-1 mt-1 border border-amber-100">
                                      📝 <span class="font-medium">Catatan:</span> {item.notes}
                                    </p>
                                  )}
                                  {item.designUrl && (
                                    <a href={item.designUrl} target="_blank" class="inline-flex items-center gap-1 text-xs text-blue-600 font-medium hover:underline mt-1">
                                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
                                      Desain Terlampir
                                    </a>
                                  )}
                                </div>
                                <div class="text-right">
                                  <p class="text-sm font-semibold text-gray-900">
                                    Rp {formatPrice(item.price * item.qty)}
                                  </p>
                                </div>
                              </div>
                            ),
                          )}
                        </div>

                        {order.status === "pending" && (
                          <div class="mt-5 pt-4 border-t border-gray-100 flex items-center gap-3 justify-end">
                            <p class="text-sm text-gray-600 flex-1">
                              Silakan selesaikan pembayaran Anda.
                            </p>
                            <button
                              data-id={order.id}
                              class="cancel-order-btn btn-ghost text-red-600 hover:bg-red-50 text-sm py-2 px-4"
                            >
                              Batalkan
                            </button>
                            <a
                              href={`https://wa.me/${contactInfo.whatsapp}?text=Halo,%20saya%20ingin%20konfirmasi%20pembayaran%20untuk%20pesanan%20%23${order.id.slice(-6).toUpperCase()}`}
                              target="_blank"
                              class="btn-primary text-sm py-2 px-4"
                            >
                              Konfirmasi Pembayaran
                            </a>
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Profile Modal -->
  <div
    id="profile-modal"
    class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4"
  >
    <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-xl">
      <h3 class="font-bold text-gray-900 text-lg mb-4">Edit Profil</h3>
      <form id="profile-form" class="space-y-4">
        <div>
          <label class="label">Nama Lengkap *</label>
          <input
            name="name"
            id="pf-name"
            required
            value={dbUser?.name}
            class="input-field"
          />
        </div>
        <div>
          <label class="label">No. Telepon</label>
          <input
            name="phone"
            id="pf-phone"
            value={dbUser?.phone || ""}
            class="input-field"
            placeholder="0812..."
          />
        </div>
        <div>
          <label class="label">Alamat Lengkap</label>
          <textarea
            name="address"
            id="pf-address"
            class="input-field"
            rows="3"
            placeholder="Jl. ...">{dbUser?.address || ""}</textarea
          >
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="label">Kota/Kabupaten</label>
            <input
              name="city"
              id="pf-city"
              value={dbUser?.city || ""}
              class="input-field"
            />
          </div>
          <div>
            <label class="label">Provinsi</label>
            <input
              name="province"
              id="pf-province"
              value={dbUser?.province || ""}
              class="input-field"
            />
          </div>
        </div>
        <div>
          <label class="label">Kode Pos</label>
          <input
            name="postalCode"
            id="pf-postal"
            value={dbUser?.postalCode || ""}
            class="input-field w-1/2"
          />
        </div>
        <div class="flex gap-3 pt-2">
          <button type="submit" class="btn-primary flex-1">Simpan</button>
          <button
            type="button"
            id="close-profile-modal"
            class="btn-ghost flex-1">Batal</button
          >
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script>
  import { generateInvoice, loadInvoiceLogo } from "../../lib/invoice";

  // Edit Profile Logic
  const profileModal = document.getElementById("profile-modal");
  const editProfileBtn = document.getElementById("edit-profile-btn");
  const closeProfileBtn = document.getElementById("close-profile-modal");
  const profileForm = document.getElementById(
    "profile-form",
  ) as HTMLFormElement;

  editProfileBtn?.addEventListener("click", () =>
    profileModal?.classList.remove("hidden"),
  );
  closeProfileBtn?.addEventListener("click", () =>
    profileModal?.classList.add("hidden"),
  );

  profileForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const submitBtn = profileForm.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Menyimpan...";

    const fd = new FormData(profileForm);
    const data = Object.fromEntries(fd);

    try {
      const res = await fetch("/api/auth/profile", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json();
        alert(err.error || "Gagal menyimpan profil");
      }
    } catch (e) {
      alert("Terjadi kesalahan jaringan");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Simpan";
    }
  });

  // Cancel Order Logic
  document.querySelectorAll(".cancel-order-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      if (!confirm("Apakah Anda yakin ingin membatalkan pesanan ini?")) return;

      const el = e.currentTarget as HTMLButtonElement;
      const orderId = el.dataset.id;
      el.disabled = true;
      el.textContent = "Membatalkan...";

      try {
        const res = await fetch(`/api/orders/${orderId}/cancel`, {
          method: "POST",
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const err = await res.json();
          alert(err.error || "Gagal membatalkan pesanan");
          el.disabled = false;
          el.textContent = "Batalkan";
        }
      } catch (err) {
        alert("Terjadi kesalahan jaringan");
        el.disabled = false;
        el.textContent = "Batalkan";
      }
    });
  });

  // Download Invoice Logic
  document.querySelectorAll(".download-invoice-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      const el = e.currentTarget as HTMLButtonElement;
      el.textContent = "Memuat...";
      el.disabled = true;
      try {
        const orderData = JSON.parse(el.dataset.order || "{}");
        const logo = await loadInvoiceLogo();
        generateInvoice(orderData, logo);
      } catch (err) {
        console.error(err);
        alert("Gagal mendownload invoice");
      } finally {
        el.innerHTML =
          '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>Invoice';
        el.disabled = false;
      }
    });
  });
</script>
