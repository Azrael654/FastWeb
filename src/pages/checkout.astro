---
import MainLayout from '../layouts/MainLayout.astro';
import ReactCheckoutForm from '../components/ReactCheckoutForm';
import { getSessionUser } from '../lib/auth';
import prisma from '../lib/prisma';

const sessionUser = getSessionUser(Astro.cookies);
let user = null;
if (sessionUser) {
  user = await prisma.appUser.findUnique({ where: { id: sessionUser.id } });
}

const paymentMethods = await prisma.paymentMethod.findMany({ 
  where: { isActive: true }, 
  orderBy: { name: 'asc' } 
});
---
<MainLayout title="Checkout – Fast Print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="section-title">Checkout</h1>
      <p class="section-subtitle">Lengkapi detail pengiriman untuk menyelesaikan pesanan</p>
    </div>

    <ReactCheckoutForm client:only="react" user={user} paymentMethods={paymentMethods} />
  </div>
</MainLayout>
