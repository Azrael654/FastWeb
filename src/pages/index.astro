---
import MainLayout from "../layouts/MainLayout.astro";
import prisma from "../lib/prisma";

const featuredProducts = await prisma.product.findMany({
  where: { isFeatured: true },
  include: { category: true },
  take: 8,
});
const categories = await prisma.category.findMany({
  where: { showInHome: true },
  take: 6,
});
---

<MainLayout>
  <!-- Hero -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-blue-700 via-blue-600 to-blue-500 text-white"
  >
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute top-10 right-10 w-72 h-72 bg-white rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute -bottom-10 -left-10 w-96 h-96 bg-yellow-300 rounded-full blur-3xl"
      >
      </div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
      <div class="max-w-3xl">
        <div
          class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-4 py-1.5 rounded-full text-sm font-medium mb-6"
        >
          <span class="w-2 h-2 bg-yellow-300 rounded-full animate-pulse"></span>
          Pengiriman ke seluruh Indonesia
        </div>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6">
          Cetak Berkualitas,<br />
          <span class="text-yellow-300">Harga Terjangkau</span>
        </h1>
        <p
          class="text-blue-100 text-lg md:text-xl mb-8 max-w-xl leading-relaxed"
        >
          Layanan cetak profesional untuk banner, brosur, kartu nama, stiker,
          dan masih banyak lagi. Kualitas premium dengan teknologi cetak
          terkini.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/shop" class="btn-secondary text-base px-8 py-3.5">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg
            >
            Belanja Sekarang
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 border-2 border-white/40 hover:border-white text-white font-semibold rounded-lg transition-all text-base"
          >
            Konsultasi Gratis
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="section-title">Kategori Produk</h2>
        <p class="section-subtitle">Temukan produk cetak yang Anda butuhkan</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {
          categories.length > 0
            ? categories.map((cat) => (
                <a
                  href={`/shop?category=${cat.slug}`}
                  class="card-hover p-5 flex flex-col items-center text-center gap-3 group cursor-pointer"
                >
                  <div class="w-14 h-14 rounded-2xl flex items-center justify-center transition-colors">
                    {cat.image ? (
                      <img
                        src={cat.image}
                        alt={cat.name}
                        class="w-14 h-14 object-cover"
                      />
                    ) : (
                      <svg
                        class="w-7 h-7 text-blue-600 transition-colors"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"
                        />
                      </svg>
                    )}
                  </div>
                  <span class="text-sm font-semibold text-gray-700 group-hover:text-blue-700 transition-colors">
                    {cat.name}
                  </span>
                </a>
              ))
            : [
                "Banner & Spanduk",
                "Brosur & Flyer",
                "Kartu Nama",
                "Stiker & Label",
                "Buku & Majalah",
                "Packaging",
              ].map((name) => (
                <a
                  href="/shop"
                  class="card-hover p-5 flex flex-col items-center text-center gap-3 group cursor-pointer"
                >
                  <div class="w-14 h-14 bg-blue-50 group-hover:bg-blue-600 rounded-2xl flex items-center justify-center transition-colors">
                    <svg
                      class="w-7 h-7 text-blue-600 group-hover:text-white transition-colors"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"
                      />
                    </svg>
                  </div>
                  <span class="text-sm font-semibold text-gray-700 group-hover:text-blue-700 transition-colors">
                    {name}
                  </span>
                </a>
              ))
        }
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="section-title">Produk Unggulan</h2>
          <p class="section-subtitle">Pilihan terbaik dari koleksi kami</p>
        </div>
        <a href="/shop" class="btn-outline hidden sm:flex">Lihat Semua</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          featuredProducts.map((product) => (
            <a href={`/shop/${product.slug}`} class="card-hover group">
              <div class="aspect-square bg-gray-100 overflow-hidden">
                {product.image ? (
                  <img
                    src={product.image}
                    alt={product.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-50 to-blue-100">
                    <svg
                      class="w-16 h-16 text-blue-300"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-4">
                {product.category && (
                  <span class="badge-blue mb-2">{product.category.name}</span>
                )}
                <h3 class="font-semibold text-gray-900 mt-1 group-hover:text-blue-600 transition-colors line-clamp-2">
                  {product.name}
                </h3>
                <p class="text-blue-600 font-bold mt-2">
                  {product.pricingType === "fixed"
                    ? `Rp ${Number(product.price).toLocaleString("id")}`
                    : `Mulai Rp ${Number(product.price).toLocaleString("id")}/${product.pricingUnit}`}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section class="py-16 bg-blue-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-3">Mengapa Memilih Fast Print?</h2>
        <p class="text-blue-200 text-lg">
          Kepercayaan ribuan pelanggan menjadi prioritas kami
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {
          [
            {
              icon: "🎨",
              title: "Kualitas Premium",
              desc: "Menggunakan tinta dan bahan berkualitas tinggi",
            },
            {
              icon: "⚡",
              title: "Pengerjaan Cepat",
              desc: "Proses cetak cepat tanpa mengurangi kualitas",
            },
            {
              icon: "💰",
              title: "Harga Kompetitif",
              desc: "Harga terbaik dengan kualitas yang terjamin",
            },
            {
              icon: "🚚",
              title: "Pengiriman Luas",
              desc: "Pengiriman ke seluruh Indonesia",
            },
          ].map((item) => (
            <div class="text-center">
              <div class="text-4xl mb-3">{item.icon}</div>
              <h3 class="text-lg font-bold mb-2">{item.title}</h3>
              <p class="text-blue-200 text-sm">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-yellow-50">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        Siap Memesan Sekarang?
      </h2>
      <p class="text-gray-600 mb-8 text-lg">
        Konsultasikan kebutuhan cetak Anda dengan tim kami. Gratis!
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/shop" class="btn-primary text-base px-8 py-3.5"
          >Lihat Produk</a
        >
        <a
          href="https://wa.me/6285117006871"
          class="btn-secondary text-base px-8 py-3.5"
          target="_blank"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"
            ></path></svg
          >
          WhatsApp Kami
        </a>
      </div>
    </div>
  </section>
</MainLayout>
