---
import MainLayout from '../../layouts/MainLayout.astro';
import prisma from '../../lib/prisma';
import { marked } from 'marked';

const { slug } = Astro.params;
const post = await prisma.blogPost.findUnique({
  where: { slug: slug as string }
});

if (!post) {
  return Astro.redirect('/404');
}

const contentHtml = marked.parse(post.content);
---
<MainLayout title={`${post.title} – Fast Print`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      {post.category && <span class="badge-blue text-sm mb-4 inline-block">{post.category}</span>}
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 leading-tight">{post.title}</h1>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span class="flex items-center gap-1.5 font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          {post.author}
        </span>
        <span>·</span>
        <span>{new Date(post.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
      </div>
    </div>

    {post.image && (
      <div class="mb-10 rounded-2xl overflow-hidden shadow-sm">
        <img src={post.image} alt={post.title} class="w-full h-auto object-cover max-h-[500px]" />
      </div>
    )}

    <article class="prose prose-blue max-w-none prose-img:rounded-xl prose-headings:font-bold prose-a:text-blue-600 hover:prose-a:text-blue-500" set:html={contentHtml} />
  </div>
</MainLayout>
