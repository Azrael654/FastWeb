---
---
<div id="media-picker-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[85vh] flex flex-col overflow-hidden transform scale-95 transition-transform duration-200" id="media-picker-card">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
      <div>
        <h3 class="text-lg font-bold text-gray-900">Pilih dari Galeri</h3>
        <p class="text-xs text-gray-500 mt-0.5">Pilih media yang sudah diunggah sebelumnya</p>
      </div>
      <button type="button" id="close-media-picker" class="w-8 h-8 flex items-center justify-center bg-white border border-gray-200 text-gray-500 hover:text-gray-900 hover:bg-gray-50 rounded-full transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    
    <div class="flex-1 overflow-y-auto p-6 bg-gray-50/30">
      <div id="media-picker-loading" class="flex justify-center py-12">
        <svg class="w-8 h-8 text-blue-600 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
      </div>
      <div id="media-picker-grid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-3 hidden">
        <!-- Images injected here -->
      </div>
    </div>

    <div class="px-6 py-4 border-t border-gray-100 flex justify-between items-center bg-white">
      <div class="text-sm text-gray-500" id="media-picker-selection-info">
        Tidak ada yang dipilih
      </div>
      <div class="flex gap-3">
        <button type="button" id="cancel-media-picker" class="btn-ghost">Batal</button>
        <button type="button" id="confirm-media-picker" class="btn-primary" disabled>Pilih Media</button>
      </div>
    </div>
  </div>
</div>

<script>
  let pickerResolve: ((urls: string[]) => void) | null = null;
  let pickerMultiple = false;
  let selectedUrls: Set<string> = new Set();
  let loadedFiles: any[] = [];

  const modal = document.getElementById('media-picker-modal')!;
  const card = document.getElementById('media-picker-card')!;
  const closeBtn = document.getElementById('close-media-picker')!;
  const cancelBtn = document.getElementById('cancel-media-picker')!;
  const confirmBtn = document.getElementById('confirm-media-picker') as HTMLButtonElement;
  const grid = document.getElementById('media-picker-grid')!;
  const loading = document.getElementById('media-picker-loading')!;
  const info = document.getElementById('media-picker-selection-info')!;

  // @ts-ignore
  window.openMediaPicker = function(options: { multiple?: boolean } = {}): Promise<string[]> {
    return new Promise((resolve) => {
      pickerResolve = resolve;
      pickerMultiple = !!options.multiple;
      selectedUrls.clear();
      updateSelectionUI();
      
      modal.classList.remove('hidden');
      setTimeout(() => card.classList.remove('scale-95'), 10);
      
      if (loadedFiles.length === 0) {
        loadMedia();
      } else {
        renderMedia();
      }
    });
  };

  function closePicker() {
    card.classList.add('scale-95');
    setTimeout(() => modal.classList.add('hidden'), 200);
    if (pickerResolve) pickerResolve([]);
    pickerResolve = null;
  }

  closeBtn.addEventListener('click', closePicker);
  cancelBtn.addEventListener('click', closePicker);
  
  confirmBtn.addEventListener('click', () => {
    if (pickerResolve) {
      pickerResolve(Array.from(selectedUrls));
      pickerResolve = null;
    }
    card.classList.add('scale-95');
    setTimeout(() => modal.classList.add('hidden'), 200);
  });

  async function loadMedia() {
    loading.classList.remove('hidden');
    grid.classList.add('hidden');
    try {
      const res = await fetch('/api/admin/gallery');
      loadedFiles = await res.json();
      renderMedia();
    } catch(e) {
      grid.innerHTML = '<div class="col-span-full text-center text-red-500">Gagal memuat galeri</div>';
    } finally {
      loading.classList.add('hidden');
      grid.classList.remove('hidden');
    }
  }

  function renderMedia() {
    grid.innerHTML = '';
    if (loadedFiles.length === 0) {
      grid.innerHTML = '<div class="col-span-full py-8 text-center text-gray-500">Galeri kosong. Unggah file di menu Galeri Media.</div>';
      return;
    }

    loadedFiles.forEach(f => {
      if (!f.mimeType.startsWith('image')) return;

      const el = document.createElement('div');
      el.className = 'media-item relative aspect-square bg-white border-2 border-transparent rounded-xl overflow-hidden cursor-pointer hover:border-blue-300 transition-colors shadow-sm';
      el.dataset.url = f.url;
      
      el.innerHTML = `
        <img src="${f.url}" class="w-full h-full object-cover" />
        <div class="check-indicator absolute top-2 right-2 w-6 h-6 bg-blue-600 text-white rounded-full items-center justify-center shadow-md hidden">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
      `;

      el.addEventListener('click', () => {
        if (pickerMultiple) {
          if (selectedUrls.has(f.url)) {
            selectedUrls.delete(f.url);
            el.classList.remove('border-blue-600');
            el.querySelector('.check-indicator')?.classList.replace('flex', 'hidden');
          } else {
            selectedUrls.add(f.url);
            el.classList.add('border-blue-600');
            el.querySelector('.check-indicator')?.classList.replace('hidden', 'flex');
          }
        } else {
          selectedUrls.clear();
          document.querySelectorAll('.media-item').forEach(item => {
             item.classList.remove('border-blue-600');
             item.querySelector('.check-indicator')?.classList.replace('flex', 'hidden');
          });
          selectedUrls.add(f.url);
          el.classList.add('border-blue-600');
          el.querySelector('.check-indicator')?.classList.replace('hidden', 'flex');
        }
        updateSelectionUI();
      });

      if (selectedUrls.has(f.url)) {
        el.classList.add('border-blue-600');
        el.querySelector('.check-indicator')?.classList.replace('hidden', 'flex');
      }

      grid.appendChild(el);
    });
  }

  function updateSelectionUI() {
    const count = selectedUrls.size;
    if (count === 0) {
      info.textContent = 'Tidak ada yang dipilih';
      confirmBtn.disabled = true;
    } else {
      info.textContent = `${count} media dipilih`;
      confirmBtn.disabled = false;
    }
  }
</script>
