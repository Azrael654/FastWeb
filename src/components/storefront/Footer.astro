---
import prisma from "../../lib/prisma";

const categories = await prisma.category.findMany({
  where: { showInFooter: true },
  take: 5,
});
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-12 lg:col-span-4">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <img
            src="/logo.svg"
            alt="Fast Print Logo"
            class="w-9 h-9 object-contain"
          />
          <div>
            <div class="text-white font-bold text-base">Fast Print</div>
            <div class="text-blue-400 text-[10px] font-medium tracking-wide">
              in FAST, we TRUST.
            </div>
          </div>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed max-w-xs">
          Solusi cetak profesional untuk kebutuhan bisnis dan personal Anda.
          Kualitas terjamin, harga terjangkau, pengiriman cepat.
        </p>
        <div class="flex items-center gap-3 mt-5">
          <a
            href="#"
            class="w-9 h-9 bg-gray-800 hover:bg-blue-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.instagram.com/fastprint300/"
            class="w-9 h-9 bg-gray-800 hover:bg-pink-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="Instagram"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
              ></rect><path
                d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zM17.5 6.5h.01"
              ></path></svg
            >
          </a>
          <a
            href="https://wa.me/6285117006871"
            class="w-9 h-9 bg-gray-800 hover:bg-green-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="WhatsApp"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path></svg
            >
          </a>
        </div>
      </div>
      <div class="md:col-span-4 lg:col-span-2">
        <h4 class="text-white font-semibold mb-4">Layanan</h4>
        <ul class="space-y-2">
          {
            categories.length > 0
              ? categories.map((cat) => (
                  <li>
                    <a
                      href={`/shop?category=${cat.slug}`}
                      class="text-sm text-gray-400 hover:text-white transition-colors"
                    >
                      {cat.name}
                    </a>
                  </li>
                ))
              : [
                  { name: "Banner & Spanduk", href: "/shop?search=banner" },
                  { name: "Brosur & Flyer", href: "/shop?search=brosur" },
                  { name: "Kartu Nama", href: "/shop?search=kartu+nama" },
                  { name: "Stiker & Label", href: "/shop?search=stiker" },
                  { name: "Buku & Majalah", href: "/shop?search=buku" },
                ].map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-sm text-gray-400 hover:text-white transition-colors"
                    >
                      {item.name}
                    </a>
                  </li>
                ))
          }
        </ul>
      </div>
      <div class="md:col-span-4 lg:col-span-3">
        <h4 class="text-white font-semibold mb-4">Kontak</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-start gap-2">
            <svg
              class="w-4 h-4 mt-0.5 text-blue-400 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            Jl. Arif Rahman Hakim No. 50A, Benteng, Warudoyong, Kota Sukabumi, Jawa
            Barat, Indonesia
          </li>
          <li class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-blue-400 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path></svg
            >
            +62 851-1700-6871
          </li>
          <li class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-blue-400 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            info@fast-print.id
          </li>
        </ul>
      </div>
      <div class="md:col-span-4 lg:col-span-3">
        <h4 class="text-white font-semibold mb-4">Lokasi Kami</h4>
        <div
          class="rounded-xl overflow-hidden h-40 bg-gray-800 border border-gray-700 relative"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3960.7452438135088!2d106.91952189999999!3d-6.921028499999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e6849fa951a6d7d%3A0xda510c7af42f14ef!2sFast%20Print!5e0!3m2!1sen!2sid!4v1779888269212!5m2!1sen!2sid"
            width="100%"
            height="100%"
            style="border:0; position:absolute; top:0; left:0;"
            allowfullscreen={false}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          >
          </iframe>
        </div>
      </div>
    </div>
    <div
      class="border-t border-gray-800 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500"
    >
      <p>&copy; {new Date().getFullYear()} Fast Print. Hak cipta dilindungi.</p>
      <div class="flex gap-4">
        <a href="/privacy" class="hover:text-gray-300 transition-colors"
          >Privasi</a
        >
        <a href="/terms" class="hover:text-gray-300 transition-colors"
          >Syarat & Ketentuan</a
        >
      </div>
    </div>
  </div>
</footer>
