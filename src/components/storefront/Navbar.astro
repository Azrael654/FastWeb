---
import ReactCartDrawer from '../ReactCartDrawer';
interface Props {
  user?: { id: string; name: string; email: string; role: string } | null;
}
const { user } = Astro.props;
const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/shop', label: 'Produk' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Kontak' },
];
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5 group">
        <img
          src="/logo.svg"
          alt="Fast Print Logo"
          class="w-9 h-9 object-contain"
        />
        <div class="flex flex-col leading-none">
          <span class="text-base font-bold text-gray-900">Fast Print</span>
          <span class="text-[10px] text-blue-600 font-medium tracking-wide">in FAST, we TRUST.</span>
        </div>
      </a>

      <div class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a href={link.href} class={`px-4 py-2 rounded-lg text-sm font-medium transition-all ${currentPath === link.href ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'}`}>
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <form action="/shop" method="GET" class="hidden md:flex items-center relative mr-1">
          <input type="text" name="search" placeholder="Cari produk..." class="w-40 lg:w-48 pl-9 pr-3 py-1.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent focus:bg-white transition-all">
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </form>

        <ReactCartDrawer client:load />

        {user ? (
          <div class="relative group">
            <button class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-gray-50 transition-all">
              <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center">
                <span class="text-sm font-bold text-blue-700">{user.name.charAt(0).toUpperCase()}</span>
              </div>
              <span class="hidden sm:block text-sm font-medium text-gray-700">{user.name.split(' ')[0]}</span>
            </button>
            <div class="hidden md:block absolute right-0 top-full mt-1 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
              <a href="/dashboard" class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Profil Saya</a>
              {user.role !== 'customer' && (
                <a href="/admin" class="flex items-center gap-2 px-4 py-2.5 text-sm text-blue-600 hover:bg-blue-50">Admin Panel</a>
              )}
              <hr class="my-1 border-gray-100" />
              <form action="/api/auth/logout" method="POST">
                <button type="submit" class="flex w-full items-center gap-2 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50">Keluar</button>
              </form>
            </div>
          </div>
        ) : (
          <a href="/login" class="btn-primary text-sm px-4 py-2">Masuk</a>
        )}

        <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-600 hover:bg-gray-100 rounded-xl" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="md:hidden hidden pb-4 border-t border-gray-100 mt-2 pt-2">
      <form action="/shop" method="GET" class="px-4 mb-3 relative">
        <input type="text" name="search" placeholder="Cari produk..." class="w-full pl-9 pr-3 py-2 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all">
        <svg class="w-4 h-4 text-gray-400 absolute left-7 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </form>
      {navLinks.map(link => (
        <a href={link.href} class={`block px-4 py-3 rounded-lg text-sm font-medium mb-1 ${currentPath === link.href ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:bg-gray-50'}`}>{link.label}</a>
      ))}
      {user && (
        <div class="mt-2 pt-2 border-t border-gray-100">
          <a href="/dashboard" class="block px-4 py-3 rounded-lg text-sm font-medium mb-1 text-gray-600 hover:bg-gray-50">Profil Saya (Dasbor)</a>
          {user.role !== 'customer' && (
            <a href="/admin" class="block px-4 py-3 rounded-lg text-sm font-medium mb-1 text-blue-600 hover:bg-blue-50">Admin Panel</a>
          )}
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="w-full text-left px-4 py-3 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50">Keluar</button>
          </form>
        </div>
      )}
    </div>
  </nav>
</header>
<script>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () =>
    document.getElementById('mobile-menu')?.classList.toggle('hidden')
  );

  // Clear cart on logout so it doesn't bleed into the next user's session
  document.querySelectorAll('form[action="/api/auth/logout"]').forEach(form => {
    form.addEventListener('submit', () => {
      localStorage.removeItem('fp_cart');
    });
  });
</script>
