---
import '../styles/global.css';
import Navbar from '../components/storefront/Navbar.astro';
import Footer from '../components/storefront/Footer.astro';
import { getSessionUser } from '../lib/auth';

const user = getSessionUser(Astro.cookies);

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Fast Print – Solusi Cetak Profesional',
  description = 'Fast Print menyediakan layanan cetak berkualitas tinggi dengan harga terjangkau. Banner, brosur, kartu nama, spanduk, dan banyak lagi.',
  image = '/og-image.png',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 antialiased overflow-x-hidden">
    <Navbar user={user} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
