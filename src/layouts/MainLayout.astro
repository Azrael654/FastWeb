---
import "../styles/global.css";
import Navbar from "../components/storefront/Navbar.astro";
import Footer from "../components/storefront/Footer.astro";
import { getSessionUser } from "../lib/auth";
import prisma from "../lib/prisma";

const user = getSessionUser(Astro.cookies);
const activePopups = await prisma.popup.findMany({
  where: { isActive: true },
  orderBy: { createdAt: "desc" },
});

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const storeConfig = await prisma.storeConfig.findUnique({
  where: { id: "singleton" },
});
const defaultStoreName = storeConfig?.storeName || "Fast Print";
const defaultTagline = storeConfig?.tagline;
const whatsappNumber = storeConfig?.whatsapp || "62812345678";
const defaultTitle = `${defaultStoreName} – ${defaultTagline}`;
const defaultDesc = `${defaultStoreName} menyediakan layanan cetak berkualitas tinggi dengan harga terjangkau. Banner, brosur, kartu nama, packaging, dan banyak lagi.`;

const {
  title = defaultTitle,
  description = defaultDesc,
  image = "/og-image.png",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5CPCTGLFCD"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-5CPCTGLFCD");
    </script>

    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 antialiased overflow-x-hidden">
    <Navbar user={user} />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Floating WhatsApp Button -->
    <a
      href={`https://wa.me/${whatsappNumber}`}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-green-500 text-white rounded-full shadow-lg hover:bg-green-600 hover:scale-110 transition-all duration-300 group"
      aria-label="Chat WhatsApp"
    >
      <svg
        class="w-8 h-8"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
      <!-- Tooltip -->
      <span
        class="absolute right-16 px-3 py-2 bg-gray-900 text-white text-xs font-medium rounded-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap shadow-md"
      >
        Hubungi Kami
      </span>
    </a>

    <!-- Popups -->
    {
      activePopups.length > 0 && (
        <div
          id="store-popups-data"
          class="hidden"
          data-popups={JSON.stringify(activePopups)}
        />
      )
    }

    <div
      id="store-popup-container"
      class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition-opacity duration-300 opacity-0"
    >
      <div
        class="bg-white rounded-2xl w-full shadow-2xl overflow-hidden relative transform scale-95 transition-transform duration-300"
        id="store-popup-card"
        style="max-width:520px"
      >
        <button
          id="store-popup-close"
          class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center bg-black/10 hover:bg-black/20 text-gray-800 rounded-full transition-colors z-10"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </button>
        <div id="store-popup-content-wrapper"></div>
      </div>
    </div>

    <script>
      const popupsDataEl = document.getElementById("store-popups-data");
      if (popupsDataEl) {
        const popups = JSON.parse(popupsDataEl.dataset.popups || "[]");
        const container = document.getElementById("store-popup-container")!;
        const card = document.getElementById("store-popup-card")!;
        const wrapper = document.getElementById("store-popup-content-wrapper")!;
        const closeBtn = document.getElementById("store-popup-close")!;

        let currentPopup: any = null;

        const showPopup = (p: any) => {
          currentPopup = p;
          let html = "";

          if (p.type === "image_only") {
            // ── Image-Only: transparent card, image floats on dark overlay ───
            card.style.maxWidth = "640px";
            // Remove white card background — image stands alone on backdrop
            card.className = card.className
              .replace("bg-white", "")
              .replace("shadow-2xl", "")
              .replace("rounded-2xl", "");
            card.style.background = "transparent";
            card.style.boxShadow = "none";

            // Dark semi-transparent close button sits top-right of image
            closeBtn.className =
              "absolute top-2 right-2 w-8 h-8 flex items-center justify-center bg-black/50 hover:bg-black/80 text-white rounded-full transition-colors z-10";

            if (p.linkUrl) {
              html = `<a href="${p.linkUrl}" target="_blank" rel="noopener noreferrer" class="block">
                        <img src="${p.imageUrl}" class="w-full block" style="max-height:80vh;object-fit:contain;border-radius:12px;" alt="${p.title}" />
                      </a>`;
            } else {
              html = `<img src="${p.imageUrl}" class="w-full block" style="max-height:80vh;object-fit:contain;border-radius:12px;" alt="${p.title}" />`;
            }
          } else {
            // ── Full: restore white card, title + content + link button ───────
            card.style.maxWidth = "512px";
            card.style.background = "";
            card.style.boxShadow = "";
            // Re-add card classes if they were stripped by a previous image_only show
            if (!card.className.includes("bg-white"))
              card.className += " bg-white";
            if (!card.className.includes("shadow-2xl"))
              card.className += " shadow-2xl";
            if (!card.className.includes("rounded-2xl"))
              card.className += " rounded-2xl";

            closeBtn.className =
              "absolute top-3 right-3 w-8 h-8 flex items-center justify-center bg-black/10 hover:bg-black/20 text-gray-800 rounded-full transition-colors z-10";

            if (p.imageUrl) {
              html += `<img src="${p.imageUrl}" class="w-full object-cover" style="max-height:280px;" alt="${p.title}" />`;
            }
            html += `<div class="p-6 text-center">`;
            html += `<h2 class="text-2xl font-bold text-gray-900 mb-2">${p.title}</h2>`;
            if (p.content) {
              html += `<p class="text-gray-600 mb-6 text-sm leading-relaxed">${p.content.replace(/\n/g, "<br/>")}</p>`;
            }
            if (p.linkUrl) {
              html += `<a href="${p.linkUrl}" class="inline-block btn-primary px-8">${p.linkText || "Cek Sekarang"}</a>`;
            }
            html += `</div>`;
          }

          wrapper.innerHTML = html;
          container.classList.remove("hidden");
          setTimeout(() => {
            container.classList.remove("opacity-0");
            card.classList.remove("scale-95");
          }, 50);

          if (p.displayMode === "session") {
            sessionStorage.setItem(`popup_${p.id}`, "shown");
          }
        };

        const closePopup = () => {
          container.classList.add("opacity-0");
          card.classList.add("scale-95");
          setTimeout(() => container.classList.add("hidden"), 300);
          if (currentPopup && currentPopup.displayMode === "once") {
            localStorage.setItem(`popup_${currentPopup.id}`, "shown");
          }
        };

        closeBtn.addEventListener("click", closePopup);
        container.addEventListener("click", (e) => {
          if (e.target === container) closePopup();
        });

        const popupToShow = popups.find((p: any) => {
          if (p.displayMode === "always") return true;
          if (
            p.displayMode === "session" &&
            !sessionStorage.getItem(`popup_${p.id}`)
          )
            return true;
          if (
            p.displayMode === "once" &&
            !localStorage.getItem(`popup_${p.id}`)
          )
            return true;
          return false;
        });

        if (popupToShow) {
          setTimeout(
            () => showPopup(popupToShow),
            (popupToShow.delaySeconds || 0) * 1000,
          );
        }
      }
    </script>
  </body>
</html>
